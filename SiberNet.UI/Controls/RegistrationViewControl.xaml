<UserControl x:Class="SiberNet.UI.Controls.RegistrationViewControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"            
 xmlns:converter="clr-namespace:SiberNet.UI.Converters"
 Visibility="{Binding ControlVisibility,
    RelativeSource={RelativeSource AncestorType=UserControl}}"
 x:Name="RegistrationControl"
 mc:Ignorable="d" 
 Background="Transparent"
 BorderThickness="0"   
 Height="Auto" 
 Width="600"
 
             Style="{StaticResource UniversalFlyOutTopStyle}" d:Opacity="1" >






    <ContentControl  Padding="0" >
        <ContentControl.Tag>
            <CornerRadius>6</CornerRadius>
        </ContentControl.Tag>
        <Grid Margin="50,30,50,20" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110*"/>
                <ColumnDefinition Width="37*"/>
            </Grid.ColumnDefinitions>

            <!-- USER NAME -->
            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,5" Grid.ColumnSpan="2">
                <Label Content="Имя пользователя:" VerticalAlignment="Center" Foreground="#FFB300"/>
                <TextBox
                Style="{StaticResource NeonTextBoxStyle}"
                Text="{Binding UserData.FirstName}" Background="#66ABC8AB"
               />

                <Label Content="{Binding ValidationResults[NameType].Message}"
                
                FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- EMAIL -->
            <StackPanel Orientation="Vertical" Margin="0,89,0,5" Grid.ColumnSpan="2" Grid.RowSpan="2">
                <Label Content="Email:" VerticalAlignment="Center" Foreground="#FFB300"  />
                <TextBox Background="#66ABC8AB"
                Style="{StaticResource NeonTextBoxStyle}"
                Text="{Binding UserData.Email}"
                />

                <Label Content="{Binding ValidationResults[EmailType].Message}"  
                
                FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- PASSWORD -->
            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,5" Grid.ColumnSpan="2">
                <Label Content="Пароль:" VerticalAlignment="Center" Foreground="#FFB300"/>
                <TextBox Background="#66ABC8AB"
                Style="{StaticResource NeonTextBoxStyle}"
                Text="{Binding UserData.Password}"
                
               />

                <Label Content="{Binding ValidationResults[PasswordType].Message}"
                
                FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- CONFIRMED PASSWORD -->
            <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,5" Grid.ColumnSpan="2">
                <Label Content="Повторите пароль:" VerticalAlignment="Center" Foreground="#FFB300"/>
                <TextBox Background="#66ABC8AB"
                Style="{StaticResource NeonTextBoxStyle}"
                Text="{Binding UserData.ConfirmPassword}"
                />

                <Label Content="{Binding ValidationResults[ConfirmedPasswordType].Message}"
                
                FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ -->
            <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,89,0,0" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="{Binding StatusMessage}" MinWidth="50" Foreground="#FFB300" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>

                <!-- BUTTONS -->
                <StackPanel Grid.Column="1" Margin="0,0,0,0" Height="45" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" MinWidth="150" Height="35"  BorderBrush="#00F0FF" BorderThickness="0.25"
                            Style="{StaticResource OrangeDefaultButtonStyle}" Margin="0,0,5,0"
                            Command="{Binding CancelCommand}" 
                         
                            Width="120"/>

                    <Button Content="{Binding SubmitButtonText}"  MinWidth="150" Height="35"
                            Style="{StaticResource OrangeDefaultButtonStyle}"  BorderBrush="#00F0FF" BorderThickness="0.25"
                            Command="{Binding ToggleRegistrationCommand}"  
                            
                            Width="120"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ContentControl>

</UserControl>

