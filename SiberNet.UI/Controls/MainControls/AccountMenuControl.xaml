<UserControl x:Class="SiberNet.UI.Controls.AccountMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiberNet.UI.Controls"
             mc:Ignorable="d" 
           Width="Auto"  >


    <Grid Background="Transparent" HorizontalAlignment="Stretch">

        <!-- 🍔 КНОПКА-БУРГЕР: привязывается к локальному контексту экрана -->
        <ToggleButton x:Name="MenuButton" 
                      Content="☰"  
                      Style="{StaticResource OrangeDefaultToggleButtonStyle}"
                      IsChecked="{Binding IsMenuOpen, Mode=TwoWay, FallbackValue=False}"
                      HorizontalAlignment="Stretch"          
                      HorizontalContentAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- 🔽 ВЫПАДАЮЩАЯ КИБЕРПАНК-ШТОРКА (POPUP) -->
        <Popup IsOpen="{Binding IsMenuOpen, Mode=TwoWay, FallbackValue=False}"
               PlacementTarget="{Binding ElementName=MenuButton}"
               Placement="Bottom"
               StaysOpen="False" 
               AllowsTransparency="True">

            <!-- Внутренний контейнер меню -->
            <Border Background="#1AADD8E6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    BorderBrush="#00F0FF" BorderThickness="0.1" CornerRadius="6" ClipToBounds="True">
                <StackPanel Margin="5">
                    <Button Content="👤 Профиль" Style="{StaticResource OrangeDefaultButtonStyle}"/>

                    <!-- 🔥 КНОПКА ВЫХОДА: вызывает команду LogoutCommand того экрана, где лежит шторка -->
                    <Button Content="↩ Выйти из системы" 
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource OrangeDefaultButtonStyle}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

