<UserControl x:Class="SiberNet.UI.Controls.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiberNet.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">

    <!-- Твоя фирменная подложка и цвета -->
    <ContentControl   >
        <ContentControl.Tag>
            <CornerRadius>6</CornerRadius>
        </ContentControl.Tag>
        <StatusBar Background="#00A3C091">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText, FallbackValue='Загрузка системы...'}"
                           Margin="2"
                           FontWeight="Bold"
                           Foreground="#FFB300"/>
            </StatusBarItem>
        </StatusBar>
        </ContentControl>
</UserControl>
