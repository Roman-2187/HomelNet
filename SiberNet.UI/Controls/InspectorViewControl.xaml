<UserControl x:Class="SiberNet.UI.Controls.InspectorViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiberNet.UI.Controls"
              xmlns:enums="clr-namespace:HomeNetCore.Models.Diagnostics;assembly=HomeNetCore"
             mc:Ignorable="d" 
             
             d:DesignHeight="450" d:DesignWidth="800"
            DataContext="{Binding InspectorViewModel,
            Source={StaticResource ComponentHub}}" >
    <ContentControl Style="{StaticResource CyberpunkImageChaildStyle}" Padding="6" Background="#FF111318">
        <ContentControl.Tag>
            <CornerRadius>6</CornerRadius>
        </ContentControl.Tag>

        <Grid>
            <Border BorderThickness="1" BorderBrush="#33FFB300" CornerRadius="4" Background="#FF111318" Padding="5">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">

                    <!-- 🔥 КИБЕРПАНК-РЕНДЕР: Повторяем логику твоего LogRenderControl! -->
                    <ItemsControl ItemsSource="{Binding GraphLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="13" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <!-- Дефолтный бирюзовый цвет для обычных заголовков и таймлайна сигналов -->
                                            <Setter Property="Foreground" Value="#00F0FF"/>
                                            <Style.Triggers>

                                                <!-- 🔴 СТАТУС: Published (Выстрел в пустоту) -> Жесткий Аварийный КРАСНЫЙ -->
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static enums:MessageState.Published}">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>

                                                <!-- 🟡 СТАТУС: Subscribed (Слушатель в засаде) -> Предупреждающий ОРАНЖЕВЫЙ -->
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static enums:MessageState.Subscribed}">
                                                    <Setter Property="Foreground" Value="#FFB300"/>
                                                </DataTrigger>

                                                <!-- 🟢 СТАТУС: Live (Живой рабочий канал) -> Наш сочный НЕОНОВО-ЗЕЛЕНЫЙ -->
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static enums:MessageState.Live}">
                                                    <Setter Property="Foreground" Value="#00FF66"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>
            </Border>
        </Grid>
    </ContentControl>
</UserControl>
