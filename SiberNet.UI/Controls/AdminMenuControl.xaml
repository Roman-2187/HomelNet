<UserControl
    x:Class="SiberNet.UI.Controls.AdminMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
    Background="Transparent" 
    mc:Ignorable="d" 
    d:DesignHeight="500" d:DesignWidth="740"
    Margin="0,10,0,0" 



   
    xmlns:enums="clr-namespace:HomeNetCore.Enums.Navigation;assembly=HomeNetCore"
             
          
            
             
            >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <!-- Лево: Пульт кнопок -->
            <ColumnDefinition Width="*"/>
            <!-- Право: Рабочая зона -->
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ЧАСТЬ: Киберпанк боковая панель кнопок -->
        <!-- Натянули твой фирменный CyberpunkImageStyle карточки -->
        <ContentControl Style="{StaticResource CyberpunkImageChaildStyle}" Tag="6" Margin="0,0,10,10">
            <StackPanel Margin="5" Background="Transparent">

                <Label Content="АДМИН ПАНЕЛЬ" 
                       FontWeight="Bold" 
                       Foreground="#FFB300"
                       HorizontalAlignment="Center" 
                       Margin="0,5,0,15"/>

                <!-- 📢 Кнопка: Показать Users (Биндится к ShowUserTableCommand) -->
                <Button Content="{Binding TableButtonText, FallbackValue='Показать users'}" 
                        Command="{Binding ShowUserTableCommand}"
                        Style="{StaticResource OrangeDefaultButtonStyle}"
                        Margin="0,3"/>

                <!-- 📢 Кнопка: Показать Логи (Биндится к ShowLogPanelCommand) -->
                <Button Content="{Binding ToggleButtonText, FallbackValue='Показать лог'}"
                        Command="{Binding ShowLogPanelCommand}" 
                        Style="{StaticResource OrangeDefaultButtonStyle}"
                        Margin="0,3"/>

                <!-- 📢 Кнопка: Удалить юзера (Биндится к ShowDeleteFormCommand) -->
                <Button Content="Удалить юзера"
                        Command="{Binding ShowDeleteFormCommand}"
                        Style="{StaticResource OrangeDefaultButtonStyle}"
                        Margin="0,3"/>

                <!-- 📢 Кнопка: Тестовый Сидинг данных (Биндится к SeedDataCommand) -->
                <Button Content="Сидинг Users" 
                        Command="{Binding SeedDataCommand}"
                        Style="{StaticResource OrangeDefaultButtonStyle}"
                        Margin="0,3"/>
            </StackPanel>
        </ContentControl>

        <!-- ПРАВАЯ ЧАСТЬ: Динамическая рабочая зона (Слой переключения панелей админки) -->
        <Grid Grid.Column="1" Margin="5,0,0,10">

            <!-- 🎭 РЕАКТИВНЫЙ ВНУТРЕННИЙ РОУТЕР АДМИНКИ НА ТРИГГЕРАХ! -->
            <!-- Каждая панель загорается ТОЛЬКО под свой энум из AdminSubTab -->

            <!-- Блок А: Таблица пользователей -->
            <Border x:Name="UserTableContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentAdminTab}" Value="UserTable">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- Тут будет сидеть твоя таблица DataGrid с юзерами, Иван! -->
                <TextBlock Text="[ТАБЛИЦА ПОЛЬЗОВАТЕЛЕЙ ИЗ SQLite / POSTGRES]" Foreground="#00F0FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Блок Б: Панель Логов -->
            <Border x:Name="LogPanelContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentAdminTab}" Value="LogPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- Тут будут сидеть наши логи админки! -->
                <TextBlock Text="[ОТЛАДОЧНЫЕ ЛОГИ БЭКЕНДА]" Foreground="#FFB300" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Блок В: Форма удаления пользователей -->
            <Border x:Name="DeleteFormContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentAdminTab}" Value="DeleteUserForm">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="[ФОРМА ХИРУРГИЧЕСКОГО УДАЛЕНИЯ ЮЗЕРА]" Foreground="#FFF23E5C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

        </Grid>
    </Grid>

</UserControl>  
