<UserControl
    x:Class="SiberNet.UI.Controls.AdminMenuViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
    Background="Transparent"
    xmlns:controls="clr-namespace:SiberNet.UI.Controls" 
    xmlns:enums="clr-namespace:HomeNetCore.Enums.Navigation;assembly=HomeNetCore"
    mc:Ignorable="d" 
    d:DesignHeight="500" d:DesignWidth="740">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <!-- Лево: Пульт кнопок -->
            <ColumnDefinition Width="*"/>
            <!--+ Право: Рабочая зона -->
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ЧАСТЬ: Киберпанк боковая панель кнопок -->
        <ContentControl
            Style="{StaticResource CyberpunkImageChaildStyle}"
            Tag="6" Margin="0,0,5,0">
            <StackPanel
               Background="Transparent">

                <Label Content="АДМИН ПАНЕЛЬ" 
                    FontWeight="Bold" 
                    Foreground="#FFB300"
                    HorizontalAlignment="Center" 
                    Margin="5"/>

                <!-- 📢 Кнопка: Показать Users -->
                <Button Content="{Binding TableButtonText, FallbackValue='Показать users'}" 
                     Command="{Binding ShowUserTableCommand}"
                     Style="{StaticResource OrangeDefaultButtonStyle}"
                     Margin="0,3"/>

                <!-- 📢 Кнопка: Показать Логи -->
                <Button Content="{Binding ToggleButtonText, FallbackValue='Показать log'}"
                     Command="{Binding ShowLogPanelCommand}" 
                     Style="{StaticResource OrangeDefaultButtonStyle}"
                     Margin="0,3"/>

                <!-- 📢 Кнопка: Удалить юзера -->
                <Button Content="{Binding DeleteButtonText, FallbackValue='Удалить юзера'}"
        Command="{Binding ShowDeleteFormCommand}"
        Style="{StaticResource OrangeDefaultButtonStyle}"
        Margin="0,3"/>

                <!-- 📢 Кнопка: Тестовый Сидинг данных -->
                <Button Content="{Binding SeedButtonText, FallbackValue='Сидинг Users'}" 
        Command="{Binding ShowSeedFormCommand}"
        Style="{StaticResource OrangeDefaultButtonStyle}"
        Margin="0,3"/>

                <!-- 📢 Кнопка: Инспектор шины -->
                <Button Content="{Binding InspectorButtonText, FallbackValue='Инспектор шины'}" 
        Command="{Binding ShowInspectorCommand}"
        Style="{StaticResource OrangeDefaultButtonStyle}"
        Margin="0,3"/>



            </StackPanel>
        </ContentControl>

        <!-- ПРАВАЯ ЧАСТЬ: Динамическая рабочая зона -->
        <Grid Grid.Column="1" Margin="0,0,0,0">

            <!-- Блок А: Настоящая таблица пользователей -->
            <Border x:Name="UserTableContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <!-- 🎯 НАСТРОИЛИ ТРИГГЕР: Следим за энумом через NavigationStateManager -->
                            <DataTrigger Binding="{Binding Navigation.CurrentAdminTab}" Value="UserTable">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <controls:UsersTableViewControl/>
            </Border>

            <!-- Блок Б: Панель Логов -->
            <Border x:Name="LogPanelContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.CurrentAdminTab}" Value="LogPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:LogRenderControl/>
            </Border>

            <!-- Блок В: Форма удаления пользователей -->
            <Border x:Name="DeleteFormContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.CurrentAdminTab}" Value="DeleteUserForm">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!-- 🎯 МЕНЯЕМ НА НАШ РЕАЛЬНЫЙ КОНТРОЛ ИЗ СТУДИИ! -->
                <controls:DeleteUsersControl/>
            </Border>






            <!-- Блок Д: Модуль генерации тестовых пользователей -->
            <Border x:Name="SeedFormContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.CurrentAdminTab}" Value="SeedUsersForm">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:SeedUsersViewControl/>
            </Border>



        </Grid>
    </Grid>



</UserControl>  
