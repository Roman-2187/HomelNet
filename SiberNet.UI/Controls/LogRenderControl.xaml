<UserControl x:Class="SiberNet.UI.Controls.LogRenderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfHomeNet.Controls"
             mc:Ignorable="d"   
             xmlns:infra="clr-namespace:SiberNet.UI.Animations"
             d:DesignHeight="450" d:DesignWidth="800"
              
             DataContext="{Binding AdminMenuViewModel, Source={StaticResource ComponentHub}}">
    <Grid>
    <!-- 🔥 ЗАРЯДИЛИ РЕНДЕРЕР ЧЕРЕЗ ПРИКРЕПЛЯЕМОЕ СВОЙСТВО НА АВТОБУС СОБЫТИЙ -->
    <RichTextBox x:Name="LogTextBox"
                     infra:LogUiAnimation.RegisterBridge="True"
                     VerticalScrollBarVisibility="Hidden"
                     IsReadOnly="True" 
                     FontSize="14" 
                     FontWeight="Bold"
                     Foreground="White" 
                     SelectionBrush="#FF297AB8">
        <RichTextBox.Style>
            <Style TargetType="RichTextBox" >
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RichTextBox">
                            <ContentControl Style="{StaticResource CyberpunkImageChaildStyle}">
                                <ContentControl.Tag>
                                    <CornerRadius>6</CornerRadius>
                                </ContentControl.Tag>
                                <!-- Системное имя PART_ContentHost сохраняет работу мыши и скролла на ура! -->
                                <ScrollViewer x:Name="PART_ContentHost" 
                                                  Margin="5"   
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Hidden"/>
                            </ContentControl>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </RichTextBox.Style>
    </RichTextBox>
    </Grid>
</UserControl>
