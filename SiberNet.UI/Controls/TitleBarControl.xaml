<UserControl x:Class="SiberNet.UI.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiberNet.UI.Controls"
             xmlns:enums="clr-namespace:HomeNetCore.Enums.Navigation;assembly=HomeNetCore"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
    
    
    
    <!-- ВНУТРЕННИЙ ГРИД ШАПКИ -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Лево: Название -->
            <ColumnDefinition Width="*"/>
            <!-- Центр: Зазор -->
            <ColumnDefinition Width="Auto"/>
            <!-- Право: Весь пульт управления -->
        </Grid.ColumnDefinitions>

        <!-- 🌌 НАЗВАНИЕ ПРИЛОЖЕНИЯ -->
        <TextBlock Grid.Column="0" 
                   Text="SIBERNET v1.0"
                   Foreground="#FFB300"
                   VerticalAlignment="Center" 
                   Margin="15,0,0,0" 
                   FontWeight="Bold"/>
        <!-- 🌌 ЕДИНЫЙ ПУЛЬТ УПРАВЛЕНИЯ СПРАВА -->
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,0,15,0">

            <!-- ================================================================= -->
            <!-- 🔑 СЕКЦИЯ А: СТАРТОВЫЙ ПУЛЬТ (Вход / Регистрация)                 -->
            <!-- Горит ТОЛЬКО на чистом начальном экране                          -->
            <!-- ================================================================= -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MainViewModel.CurrentMainTab, Source={StaticResource ComponentHub}}" Value="ClientZone">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MainViewModel.CurrentMainTab, Source={StaticResource ComponentHub}}" Value="AdminZone">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                
                
            <!-- 🛠️ КНОПКА АДМИНКИ (Вне панели скрытия, работает как независимый тумблер!) -->
            <Button x:Name="Adminka" Content="🛠️ Админка" Width="110" Margin="0,0,20,0"
    Command="{Binding MainViewModel.ToggleAdminZoneCommand, Source={StaticResource ComponentHub}}"
    Style="{StaticResource OrangeDefaultButtonStyle}"/>


                

                <!-- Кнопка Входа -->
                <Button Content="🔑 Вход"
        Command="{Binding MainViewModel.SwitchClientTabCommand, Source={StaticResource ComponentHub}}"
        CommandParameter="{x:Static enums:ClientSubTab.Authentication}"
        Style="{StaticResource OrangeDefaultButtonStyle}" Width="110" Margin="0,0,10,0"/>

                <!-- Кнопка Регистрации -->
                <Button Content="📝 Регистрация"
        Command="{Binding MainViewModel.SwitchClientTabCommand, Source={StaticResource ComponentHub}}"
        CommandParameter="{x:Static enums:ClientSubTab.Registration}"
        Style="{StaticResource OrangeDefaultButtonStyle}" Width="110"/>
                
                
                
            </StackPanel>


            <!-- 🛠️ СЕКЦИЯ Б: КНОПКА ГЛОБАЛЬНОГО ВЫХОДА / ОТМЕНЫ -->
            <!-- Убрали Style="..." из самого тега Button! -->
            <Button Content="↩ Выход" 
                Command="{Binding MainViewModel.LogoutCommand,
                Source={StaticResource ComponentHub}}"
                Width="65"
                Margin="0,0,20,0">

                <Button.Style>
                    <!-- Базовый стиль наследуем через BasedOn прямо тут! -->
                    <Style TargetType="Button"
                           BasedOn="{StaticResource CyberpunkCloseButtonStyle}">
                        <!-- По умолчанию скрываем на старте -->
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <!-- Включаем видимость в рабочих зонах -->
                            <DataTrigger Binding="{Binding MainViewModel.CurrentMainTab,
                                Source={StaticResource ComponentHub}}" Value="ClientZone">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MainViewModel.CurrentMainTab,
                                Source={StaticResource ComponentHub}}" Value="AdminZone">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>



            <!-- ================================================================= -->
            <!-- 👑 СЕКЦИЯ В: ГЛОБАЛЬНЫЕ СИСТЕМНЫЕ КНОПКИ (Всегда прибиты вправо) -->
            <!-- ================================================================= -->
            <StackPanel Orientation="Horizontal">
                <!-- ⚡ Дебаг -->
                <Button Content="⚡ Дебаг" 
                    Command="{Binding MainViewModel.ToggleGlobalLoggerCommand,
                    Source={StaticResource ComponentHub}}"
                    Style="{StaticResource CyberpunkCloseButtonStyle}"
                    Width="80"
                    Margin="0,0,10,0"
                    WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- 🔳 Вырастание -->
                <Button Content="🔳" 
                    Command="{Binding MainViewModel.ToggleGrowWindowCommand,
                    Source={StaticResource ComponentHub}}"
                    Style="{StaticResource CyberpunkCloseButtonStyle}"
                    Margin="0,0,5,0"/>

                <!-- ✕ Крестик -->
                <Button Content="✕" 
                    Command="{Binding MainViewModel.RequestCloseApplicationCommand,
                    Source={StaticResource ComponentHub}}"
                    Style="{StaticResource CyberpunkCloseButtonStyle}"/>
            </StackPanel>

        </StackPanel>



    </Grid>
</UserControl>
