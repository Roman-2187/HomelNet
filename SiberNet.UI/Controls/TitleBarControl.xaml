<UserControl x:Class="SiberNet.UI.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:vm="clr-namespace:HomeNetPresentation.ViewModels;assembly=HomeNetPresentation" 
             xmlns:enums="clr-namespace:HomeNetCore.Enums.Navigation;assembly=HomeNetCore"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiberNet.UI.Controls"
             xmlns:views="clr-namespace:SiberNet.UI"                                               
             DataContext="{Binding TitleBarViewModel, Source={StaticResource ComponentHub}}" 
             mc:Ignorable="d"   d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- 👑 ВЕРХНЯЯ ПАНЕЛЬ ШАПКИ (ЧИСТАЯ И РАЗГРУЖЕННАЯ)                    -->
        <!-- ================================================================= -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 🌌 НАЗВАНИЕ ПРИЛОЖЕНИЯ -->
            <TextBlock Grid.Column="0" Text="SIBERNET v1.0"
                   Foreground="#FFB300"
                   VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>

            <!-- 🌌 ЕДИНЫЙ ПУЛЬТ УПРАВЛЕНИЯ СПРАВА -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">

                <!-- 🔥 СЕКЦИЯ А: СТАРТОВЫЙ ПУЛЬТ (Админка, Вход, Регистрация) -->
                <!-- По умолчанию панель скрыта. Она проявится ТОЛЬКО на стартовой заставке -->
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- 🔥 ЖЕСТКИЙ КОНТРОЛЬ СВЕТА: Кнопки горят, только если на шапке два стартовых нуля! -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CurrentMainZone}"
                                                   Value="{x:Static enums:MainTab.StartZone}"/>
                                        <Condition Binding="{Binding CurrentClientTab}"
                                                   Value="{x:Static enums:ClientSubTab.None}"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Content="🛠️ Админка" Width="110" Margin="0,0,20,0"
                            Command="{Binding ToggleAdminZoneCommand}" 
                            Style="{StaticResource OrangeDefaultButtonStyle}" 
                            WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <Button Content="🔑 Вход" 
                            Command="{Binding OpenAuthZoneCommand}"
                            Style="{StaticResource OrangeDefaultButtonStyle}" Width="110" 
                            Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <Button Content="📝 Регистрация" 
                            Command="{Binding OpenRegisterZoneCommand}"
                            Style="{StaticResource OrangeDefaultButtonStyle}" Width="110" 
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>

                <!-- СЕКЦИЯ В: СИСТЕМНЫЕ КНОПКИ -->
                <StackPanel Orientation="Horizontal">
                    

                    <Button Content="🔳" Command="{Binding ToggleGrowWindowCommand}"
                    Style="{StaticResource OrangeDefaultButtonStyle}" Margin="0,0,5,0" 
                    WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <Button Content="✕" Command="{Binding RequestCloseApplicationCommand}" 
                    Style="{StaticResource OrangeDefaultButtonStyle}" Width="30"
                    WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================================================================= -->
        <!-- 🌌 ВЛАСТЬ НАД ЦЕНТРАЛЬНЫМ ХОЛСТОМ (ПЕРЕВЕДЕНО НА VISIBILITY)     -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,5">

            <!-- Экран А: Форма Входа (Authentication) -->
            <Border x:Name="AuthScreenContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentClientTab}"
                                         Value="{x:Static enums:ClientSubTab.Authentication}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <local:AuthenticationViewControl 
                    DataContext="{Binding AuthenticationViewModel,
                    Source={StaticResource ComponentHub}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Экран Б: Панель Администратора -->
            <Border x:Name="AdminScreenContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentMainZone}"
                                         Value="{x:Static enums:MainTab.AdminZone}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <local:AdminMenuViewControl 
                    DataContext="{Binding AdminMenuViewModel,
                    Source={StaticResource ComponentHub}}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>

            <!-- Экран В: Форма Регистрации -->
            <Border x:Name="RegisterScreenContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentClientTab}"
                                         Value="{x:Static enums:ClientSubTab.Registration}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <local:RegistrationViewControl 
                    DataContext="{Binding RegistrationViewModel,
                    Source={StaticResource ComponentHub}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Экран Г: Рабочая Зона Пользователя (Мессенджер SiberNet) -->
            <Border x:Name="UserScreenContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentMainZone}"
                                         Value="{x:Static enums:MainTab.ClientZone}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <local:UserProfileControl 
                    DataContext="{Binding UserProfileViewModel, 
                    Source={StaticResource ComponentHub}}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>

        </Grid>
    </Grid>


</UserControl>
