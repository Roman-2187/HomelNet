<UserControl x:Class="SiberNet.UI.Controls.SeedUsersViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiberNet.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
               DataContext="{Binding SeedUsersViewModel, Source={StaticResource ComponentHub}}">
    <ContentControl Style="{StaticResource CyberpunkImageChaildStyle}"
                    Padding="15" Background="#FF1E222A">
        <ContentControl.Tag>
            <CornerRadius>6</CornerRadius>
        </ContentControl.Tag>

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <TextBlock Text="⚡ ЦЕНТРАЛЬНЫЙ МОДУЛЬ СИДИНГА ДАННЫХ" 
                           Foreground="#FFB300" FontWeight="Bold" FontSize="16" 
                           HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <Border BorderThickness="1" BorderBrush="#33FFB300" 
                        Background="#FF111318" CornerRadius="4"
                        Padding="15" Margin="0,0,0,20">
                    <TextBlock Text="{Binding SeedStatusText}" 
                               FontFamily="Consolas" FontSize="13" 
                               Foreground="#00FFCC" TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Кнопка запуска генерации -->
                <Button Content="ЗАПУСТИТЬ ГЕНЕРАЦИЮ БАЗЫ (50 USERS)" 
                        Command="{Binding ExecuteDataSeedingCommand}"
                        
                    
                        Style="{StaticResource OrangeDefaultButtonStyle}"
                        Width="320" Height="45" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </ContentControl>


</UserControl>
