<UserControl x:Class="SiberNet.UI.Controls.UserDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiberNet.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"  
            Background="Transparent"
             
             d:Opacity="1"
               
   
            
             >


    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <!-- Левая панель под список контактов -->
            <ColumnDefinition Width="200"/>
            <!-- Правая панель под область переписки -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 👤 ЛЕВАЯ ПАНЕЛЬ: ТЕПЕРЬ ТУТ КРАСИВЫЙ ВЫДЕЛЕННЫЙ КОНТРОЛ -->
        <local:FriendsListViewControl
            Grid.Column="0" Margin="0,0,5,0"
            />

        <StackPanel Orientation="Horizontal" >

            <!-- 🍔 Наш чистый квадратный бургер -->
            <local:AccountMenuControl VerticalContentAlignment="Top"/>

            <!-- 📝 Надпись пишем прямо тут, по месту требования -->
            <TextBlock Text="ДРУЗЬЯ"
                   Foreground="#8A95A5" 
                   FontWeight="Bold"
                   VerticalAlignment="Top" 
                   Margin="10" 
                   FontSize="12" />
        </StackPanel>


        <!-- 💬 ПРАВАЯ ПАНЕЛЬ: ЧАТ С УМНОЙ АНИМАЦИЕЙ ПОЛЕТА СВЕРХУ -->
        <ContentControl Grid.Column="1" >
            <local:ChatViewControl DataContext="{Binding ChatVm}" />
        </ContentControl>
    </Grid>
</UserControl>
