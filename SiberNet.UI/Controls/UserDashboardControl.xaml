<UserControl x:Class="WpfHomeNet.Controls.UserDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfHomeNet.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"  Margin="0,0,0,5"
            
             
             d:Opacity="1"
               
    Style="{StaticResource UniversalFlyOutBottomStyle}"
             DataContext="{Binding UserDashboardVm, Source={StaticResource VmLocator}}"
             >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: СПИСОК ДРУЗЕЙ -->
        <ContentControl Grid.Column="0" Style="{StaticResource CyberpunkImageChaildStyle}">
            <ContentControl.Tag>
                <CornerRadius>10</CornerRadius>
            </ContentControl.Tag>

            <!-- 🔥 ДОБАВИЛИ SelectedItem: теперь каждый клик по имени запишет юзера во ViewModel! -->
            <ListBox ItemsSource="{Binding Friends}" 
             SelectedItem="{Binding SelectedFriend, Mode=TwoWay}"
             ItemContainerStyle="{StaticResource CyberpunkContactItemStyle}"
             DisplayMemberPath="FirstName" 
             Background="Transparent" 
             BorderThickness="0"
             Margin="5"/>
        </ContentControl>


        <!-- ПРАВАЯ ПАНЕЛЬ: ЧАТ С УМНОЙ АНИМАЦИЕЙ ПОЛЕТА СВЕРХУ -->
        <ContentControl Grid.Column="1" >
            <local:ChatViewControl DataContext="{Binding ChatVm, Source={StaticResource VmLocator}}" />
        </ContentControl>
        
        
 
    </Grid>
</UserControl>
