<UserControl x:Class="SiberNet.UI.Controls.UserDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiberNet.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"  Margin="0,0,0,5"
            
             
             d:Opacity="1"
               
    Style="{StaticResource UniversalFlyOutBottomStyle}"
            
             >

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Левая панель под список контактов -->
            <ColumnDefinition Width="200"/>
            <!-- Правая панель под область переписки -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 👤 ЛЕВАЯ ПАНЕЛЬ: СПИСОК ДРУЗЕЙ (Смотрит в изолированную ContactsListVM) -->
        <ContentControl Grid.Column="0" Style="{StaticResource CyberpunkImageChaildStyle}">
            <ContentControl.Tag>
                <CornerRadius>10</CornerRadius>
            </ContentControl.Tag>

            <!-- 🔥 ПЕРЕНАПРАВИЛИ БИНДИНГИ: Теперь ListBox заходит внутрь ContactsListVM -->
            <ListBox ItemsSource="{Binding ContactsListVM.Friends}" 
                     SelectedItem="{Binding ContactsListVM.SelectedFriend, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource CyberpunkContactItemStyle}"
                     DisplayMemberPath="FirstName" 
                     Background="Transparent" 
                     BorderThickness="0"
                     Margin="5"/>
        </ContentControl>

        <!-- 💬 ПРАВАЯ ПАНЕЛЬ: ЧАТ С УМНОЙ АНИМАЦИЕЙ ПОЛЕТА СВЕРХУ -->
        <ContentControl Grid.Column="1">
            <!-- 🔥 ПОПРАВИЛИ: Чистая прямая привязка к ChatVm текущего контекста дашборда -->
            <local:ChatViewControl DataContext="{Binding ChatVm}" />
        </ContentControl>
    </Grid>
</UserControl>
