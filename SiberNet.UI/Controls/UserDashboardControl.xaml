<UserControl x:Class="SiberNet.UI.Controls.UserDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiberNet.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"  
            Background="Transparent"
             
             d:Opacity="1"
               
   
            
             >

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Левая панель под список контактов (фиксированные 160 пикселей) -->
            <ColumnDefinition Width="165"/>
            <!-- Правая панель под область переписки -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 👤 ЛЕВАЯ ПАНЕЛЬ: Теперь контрол сам внутри себя содержит и шапку, и рамку! -->
        <local:FriendsListViewControl Grid.Column="0" 
                                      Margin="0,0,5,0"
                                      />

        <!-- 💬 ПРАВАЯ ПАНЕЛЬ: ЧАТ С УМНОЙ АНИМАЦИЕЙ -->
        <ContentControl Grid.Column="1">
            <local:ChatViewControl DataContext="{Binding ChatVm}" />
        </ContentControl>
    </Grid>
</UserControl>
