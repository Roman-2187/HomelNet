<UserControl x:Class="SiberNet.UI.Controls.UsersTableViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"  
             
              DataContext="{Binding TableUsersViewModel, Source={StaticResource ComponentHub}}">

   
    <ContentControl Style="{StaticResource CyberpunkImageChaildStyle}" Tag="6"
                    >

        <!-- 📐 Добавляем Margin="4", чтобы ячейки таблицы не врезались в линии скоса углов -->
        <Grid Margin="10">
            <!-- Две строки: заголовки и данные -->
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition MinHeight="100" Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Заголовки с внутренней рамкой -->
            <ContentControl Style="{StaticResource InnerBorderTitleStyle}" 
                            Grid.Row="0" Margin="2"
                            Grid.ColumnSpan="7"  
                            Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition MinWidth="70" MaxWidth="170"/>
                        <ColumnDefinition MinWidth="80" MaxWidth="170"/>
                        <ColumnDefinition MinWidth="100" MaxWidth="180"/>
                        <ColumnDefinition MinWidth="200"/>
                        <ColumnDefinition MinWidth="90"/>
                        <ColumnDefinition MinWidth="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="  ID" Foreground="#00F0FF" />
                    <TextBlock Grid.Column="1" Text="Имя" Foreground="#00F0FF"/>
                    <TextBlock Grid.Column="2" Text="Фамилия" Foreground="#00F0FF"/>
                    <TextBlock Grid.Column="3" Text="Телефон" Foreground="#00F0FF"/>
                    <TextBlock Grid.Column="4" Text="Email" Foreground="#00F0FF"/>
                    <TextBlock Grid.Column="5" Text="Пароль" Foreground="#00F0FF"/>
                    <TextBlock Grid.Column="6" Text="Дата создания" Foreground="#00F0FF"/>
                </Grid>
            </ContentControl>

            <!-- 2. Скроллер данных -->
            <ScrollViewer Grid.Row="1"
                          x:Name="UserPanel"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          Focusable="False"
                          Background="Transparent">

                <ItemsControl ItemsSource="{Binding Users}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Stretch" 
                              Foreground="#00F0FF">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition MinWidth="70" MaxWidth="170"/>
                                    <ColumnDefinition MinWidth="80" MaxWidth="170"/>
                                    <ColumnDefinition MinWidth="100" MaxWidth="160"/>
                                    <ColumnDefinition MinWidth="180"/>
                                    <ColumnDefinition MinWidth="100"/>
                                    <ColumnDefinition MinWidth="120"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ячейки с привязкой границ к родительскому ItemsControl -->
                                <ContentControl Grid.Column="0" Content="{Binding Id}"   
                                                Style="{StaticResource BorderedContentStyle}" 
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                HorizontalAlignment="Stretch"/>

                                <ContentControl Grid.Column="1" Content="{Binding FirstName}"
                                                Style="{StaticResource BorderedContentStyle}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                HorizontalAlignment="Stretch"/>

                                <ContentControl Grid.Column="2" Content="{Binding LastName}" 
                                                Style="{StaticResource BorderedContentStyle}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                HorizontalAlignment="Stretch"/>

                                <ContentControl Grid.Column="3" Content="{Binding PhoneNumber}" 
                                                Style="{StaticResource BorderedContentStyle}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                HorizontalAlignment="Stretch"/>

                                <ContentControl Grid.Column="4" Content="{Binding Email}"   
                                                Style="{StaticResource BorderedContentStyle}" 
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                HorizontalAlignment="Stretch"/>

                                <ContentControl Grid.Column="5" Content="{Binding Password}" 
                                                Style="{StaticResource BorderedContentStyle}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                HorizontalAlignment="Stretch"/>

                                <ContentControl Grid.Column="6" Content="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                                Style="{StaticResource BorderedContentStyle}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                HorizontalAlignment="Stretch"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </ContentControl>
    
    </UserControl>




