<UserControl
    x:Class="SiberNet.UI.Controls.DeleteUsersControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    mc:Ignorable="d" 
    d:DesignHeight="400" d:DesignWidth="600" 
    >


    <ContentControl
        DataContext="{Binding DeleteUsersViewModel,
        Source={StaticResource ComponentHub}}" 
        Style="{StaticResource CyberpunkImageChaildStyle}"
        Tag="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- Строка 0: Сплит-панели (Левая и Правая зоны) -->
                <RowDefinition Height="Auto"/>
                <!-- Строка 1: Нижняя панель кнопок -->
            </Grid.RowDefinitions>

            <!-- 🎯 ГЛАВНЫЙ ССПЛИТ-КОНТЕЙНЕР НА ВЕСЬ ЭКРАН -->
            <Grid Grid.Row="0" Margin="15,15,15,5">
                <Grid.ColumnDefinitions>
                    <!-- 🔥 ЖЕЛЕЗОБЕТОННЫЙ БАН СЖАТИЯ ЛЕВОЙ ЧАСТИ МЕНЬШЕ 200 -->
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <!-- Колонка под разделитель -->
                    <ColumnDefinition Width="*" />
                    <!-- Правая колонка (Журнал аудита) -->
                </Grid.ColumnDefinitions>

                <!-- ================= ЛЕВАЯ ЧАСТЬ (ЕДИНЫЙ ГРИД) ================= -->
                <Grid Grid.Column="0" Margin="0,0,5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 0: Заголовок формы -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Панель поиска -->
                        <RowDefinition Height="*"/>
                        <!-- 2: Живой список -->
                    </Grid.RowDefinitions>

                    <!-- 👑 ЗАГОЛОВОК НАПРОТИВ КНОПКИ НАЙТИ -->
                    <TextBlock Grid.Row="0"
                           Text="Удаление учетных записей"
                           Foreground="#FFF5546F"
                           FontWeight="Bold" 
                           FontSize="14"
                           Margin="0,5,0,5"
                           VerticalAlignment="Center"/>

                    <!-- Панель поиска (TextBox растягивается,
                    кнопка прижата справа) -->
                    <Grid Grid.Row="1" Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"  />
                            <!-- TextBox заберет всё свободное место -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Кнопка -->
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding TargetUserId, 
                            UpdateSourceTrigger=PropertyChanged}"
                             Grid.Column="0"
                             BorderBrush="#FF211E19"
                             BorderThickness="0.5"
                             
                             HorizontalAlignment="Stretch" 
                             Height="35"
                             VerticalContentAlignment="Center"
                             Foreground="#FFF5546F"
                             Padding="5,0,0,0"
                             Background="#1AADD8E6"/>

                        <Button Content="Найти" 
                            Grid.Column="1"
                            Width="90" Height="35"
                            Margin="10,0,0,0"
                            Command="{Binding SearchCommand}"
                            Background="Transparent" />
                    </Grid>

                    <!-- Живой список пользователей с закруглёнными углами -->
                    <Border Grid.Row="2"
                         Background="#1AADD8E6"
                        
                        BorderBrush="#FFF5546F"
                        CornerRadius="6"
                        ClipToBounds="True">
                        <!-- 🔥 ЖЕЛЕЗОБЕТОННЫЙ ОБРЕЗАТЕЛЬ УГЛОВ -->
                        <ListBox BorderThickness="0"
                             ItemsSource="{Binding FoundUsers}"
                             SelectedItem="{Binding SelectedUser}"
                             DisplayMemberPath="DisplayInfo" 
                             Background="Transparent"
                             SelectedValuePath="Id"  
                             Margin="10" 
                             Foreground="#FFF5546F"/>
                    </Border>
                </Grid>

                <!-- 🔥 КИБЕРПАНК-РАЗДЕЛИТЕЛЬ НА ВСЮ ВЫСОТУ ФОРМЫ -->
                <GridSplitter Grid.Column="1"
                          Width="4"
                          Cursor="SizeWE" 
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#6600FFFF" 
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Margin="3,0,3,0"/>

                <!-- ================= ПРАВАЯ ЧАСТЬ (ЖУРНАЛ ИСТОРИИ) ==-->
                <Border Grid.Column="2"               
                    Margin="5,30,0,0"
                    BorderThickness="0"
                    BorderBrush="#FFF5546F"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Text="Журнал истории удаления (Текущая сессия)"
                            Foreground="#FFF5546F"
                            FontSize="11"
                            FontWeight="Bold"
                            Margin="10,10,10,5"/>

                        <Border Grid.Row="1"        
                            Background="#1AADD8E6"
                            Margin="5,25,0,0"
                            BorderThickness="0"
                            BorderBrush="#00F0FF"
                            CornerRadius="6"
                            ClipToBounds="True">
                            <ListBox
                                ItemsSource="{Binding DeletedUsersHistory}"
                                Background="Transparent"
                                Margin="10,10"  
                                BorderThickness="0" 
                                Foreground="#00F0FF"
                                IsHitTestVisible="False"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 🔥 ВОЗВРАЩЕННАЯ НИЖНЯЯ ПАНЕЛЬ: Кнопки и общий статус -->
            <Grid Grid.Row="1" Margin="15,10,15,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Место под статус -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Под кнопки -->
                </Grid.ColumnDefinitions>

                <!-- Локальный статус-лабел слева -->
                <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       Foreground="#FFF5546F"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="0,0,20,0"/>

                <!-- Блок кнопок управления прижат строго вправо -->
                <StackPanel Grid.Column="1" 
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                    <Button Width="80" Height="35"
                        Content="Удалить" 
                        Margin="0,0,10,0"
                        Command="{Binding ExecuteDeleteCommand}"
                        Background="Transparent" />

                    <Button Width="80" Height="35"
                        Content="Отмена"
                        Command="{Binding CancelCommand}"
                        Background="Transparent" />
                </StackPanel>
            </Grid>
        </Grid>
    </ContentControl>




</UserControl>

