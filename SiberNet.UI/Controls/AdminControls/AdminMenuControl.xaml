<UserControl
    x:Class="SiberNet.UI.Controls.AdminMenuViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
    Background="Transparent"
    xmlns:controls="clr-namespace:SiberNet.UI.Controls" 
    xmlns:enums="clr-namespace:HomeNetCore.Enums.Navigation;assembly=HomeNetCore"
    mc:Ignorable="d" 
    d:DesignHeight="500" d:DesignWidth="740" >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ЧАСТЬ: Боковая панель -->
        <ContentControl Style="{StaticResource CyberpunkImageChaildStyle}" Tag="6" Margin="0,0,5,0">
            <StackPanel Background="Transparent">
                <Label Content="АДМИН ПАНЕЛЬ" FontWeight="Bold"
                       Foreground="#FFF5546F" HorizontalAlignment="Center" Margin="5"/>

                <Button Content="{Binding TableButtonText, FallbackValue='Показать users'}" 
                        Command="{Binding ShowUserTableCommand}"
                        Style="{StaticResource OrangeDefaultButtonStyle}"
                        Margin="0,3"/>
                <Button Content="{Binding ToggleButtonText, FallbackValue='Показать log'}" 
                        Command="{Binding ShowLogPanelCommand}" 
                        Style="{StaticResource OrangeDefaultButtonStyle}" Margin="0,3"/>
                <Button Content="{Binding DeleteButtonText, FallbackValue='Удалить юзера'}"
                        Command="{Binding ShowDeleteFormCommand}"
                        Style="{StaticResource OrangeDefaultButtonStyle}" 
                        Margin="0,3"/>
                <Button Content="{Binding SeedButtonText, FallbackValue='Сидинг Users'}" 
                        Command="{Binding ShowSeedFormCommand}" 
                        Style="{StaticResource OrangeDefaultButtonStyle}" Margin="0,3"/>
                <Button Content="{Binding InspectorButtonText, FallbackValue='Инспектор шины'}" 
                        Command="{Binding ShowInspectorCommand}" 
                        Style="{StaticResource OrangeDefaultButtonStyle}" Margin="0,3"/>
                <!-- 🔥 ЖЕЛЕЗОБЕТОННЫЙ ПЕРЕХВАТ: Шторка рулится макро-зоной из TitleBarViewModel -->
                <!-- 🔥 ЖЕСТКОЕ ГАСИЛОВО ПОД ГЛОБАЛЬНЫМ МАКРО-КОНТРОЛЕМ -->
                <!-- Шторка живет и отображается ТОЛЬКО пока мы физически находимся в AdminZone! -->

                <!-- 🔥 ЧИСТОЕ РЕШЕНИЕ: Управляем видимостью самого контрола напрямую! -->
                <controls:AccountMenuControl HorizontalAlignment="Stretch" 
                                             HorizontalContentAlignment="Stretch"/>



            </StackPanel>
        </ContentControl>

        <!-- ПРАВАЯ ЧАСТЬ: Выровненная рабочая зона -->
        <Grid Grid.Column="1">

            <!-- Блок А: Таблица пользователей -->
            <Border x:Name="UserTableContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <!-- 🎯 Вяжемся к ActiveTab и сверяем со строгим энумом ядра -->
                            <DataTrigger Binding="{Binding ActiveTab}"
                                         Value="{x:Static enums:AdminSubTab.UserTable}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:UsersTableViewControl/>
            </Border>

            <!-- Блок Б: Панель Логов -->
            <Border x:Name="LogPanelContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <!-- 🎯 Заменили значение на Logger строго по энуму -->
                            <DataTrigger Binding="{Binding ActiveTab}"
                                         Value="{x:Static enums:AdminSubTab.Logger}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:LogRenderControl/>
            </Border>

            <!-- Блок В: Форма удаления пользователей -->
            <Border x:Name="DeleteFormContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <!-- 🎯 Заменили значение на DeleteUsers строго по энуму -->
                            <DataTrigger Binding="{Binding ActiveTab}"
                                         Value="{x:Static enums:AdminSubTab.DeleteUsers}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:DeleteUsersControl/>
            </Border>

            <!-- Блок Г: Инспектор шины событий -->
            <Border x:Name="InspectorFormContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}"
                                         Value="{x:Static enums:AdminSubTab.EventInspector}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:InspectorViewControl/>
            </Border>

            <!-- Блок Д: Модуль генерации тестовых пользователей -->
            <Border x:Name="SeedFormContainer" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <!-- 🎯 Заменили значение на SeedUsers строго по энуму -->
                            <DataTrigger Binding="{Binding ActiveTab}"
                                         Value="{x:Static enums:AdminSubTab.SeedUsers}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:SeedUsersViewControl/>
            </Border>

        </Grid>
    </Grid>



</UserControl>  
