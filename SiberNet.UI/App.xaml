<Application 
    x:Class="SiberNet.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infrastructure="clr-namespace:SiberNet.UI.Infrastructure"             
    xmlns:cv="clr-namespace:SiberNet.UI.Converters" 
    xmlns:enums="clr-namespace:HomeNetCore.Enums.Navigation;assembly=HomeNetCore" 
    xmlns:controls="clr-namespace:SiberNet.UI.Controls" 
    xmlns:vm="clr-namespace:HomeNetPresentation.ViewModels;assembly=HomeNetPresentation" 
    StartupUri="MainWindow.xaml">
    

    <Application.Resources>
          
        <cv:CornerRadiusConverter x:Key="RadiusCalc" />
        <infrastructure:ComponentHub x:Key="ComponentHub"/>

<!-- 1. ВАШ СТИЛЬ (ПЕРЕИМЕНОВАННЫЙ В ИМЕННОЙ) -->
        <Style x:Key="OrangeDefaultButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <!-- Оранжево-золотые буквы по умолчанию -->
            <Setter Property="Foreground" Value="#FFB300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.FontWeight="{TemplateBinding FontWeight}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF23E5C"/>
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#00F0FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00F0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF131926"/>
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="White"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF0D111A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#FF615959"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        

<Style x:Key="CyberpunkImageStyle" TargetType="ContentControl">
            <Setter Property="Tag" Value="0"/>
            <Setter Property="Padding" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 👑 ВНЕШНИЙ БОРДЕР -->
                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                            BorderThickness="1" BorderBrush="#FFF23E5C" Background="#FF1B222E">
                                <Grid>
                                    <!-- 🥈 СРЕДНИЙ БОРДЕР -->
                                    <Border BorderThickness="1.5" Margin="0" BorderBrush="#40F23E5C" 
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RadiusCalc}, ConverterParameter=-0.5}"/>

                                    <!-- 🥉 ВНУТРЕННИЙ БОРДЕР -->
                                    <Border Margin="1.5" BorderThickness="0"
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RadiusCalc}, ConverterParameter=-1.0}"
                                    Background="#FF1C2433">
                                        <Grid>
                                            <!-- 🖼️ СЛОЙ С КАРТИНКОЙ -->
                                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RadiusCalc}, ConverterParameter=-1.0}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="pack://application:,,,/SiberNet.UI;component/Resourses/68fadad90ca053b59b3e0178c4983607.png" 
                                                        Stretch="UniformToFill" 
                                                        Opacity="0.2"/>
                                                </Border.Background>
                                            </Border>

                                            <!-- 🔥 ЖЕЛЕЗНЫЙ МОСТ КОНТЕНТА: Насильно связываем презентер с контентом! -->
                                            <ContentPresenter Content="{TemplateBinding Content}" 
                                                      Margin="{TemplateBinding Padding}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="CyberpunkImageChaildStyle" TargetType="ContentControl">
            <Setter Property="Tag" Value="0"/>
            <Setter Property="Padding" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 👑 ВНЕШНИЙ БОРДЕР: Рамка та же, но фон подкладки осветлен на 10% -->
                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
        BorderThickness="0.4" BorderBrush="#00F0FF" Background="#FF1B222E">
                                <Grid>
                                    <!-- 🥈 СРЕДНИЙ БОРДЕР -->
                                    <Border BorderThickness="0.1" Margin="0" BorderBrush="#40F23E5C" 
                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                Converter={StaticResource RadiusCalc}, ConverterParameter=-0.5}"/>

                                    <!-- 🥉 ВНУТРЕННИЙ БОРДЕР: Основной фон карточки -->
                                    <Border Margin="1.5" BorderThickness="0"
                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, 
                Converter={StaticResource RadiusCalc}, ConverterParameter=-1.0}"
                Background="#FF1C2433">
                                        <!-- Мягкий темно-сизый графит -->

                                        <Grid>
                                            <!-- 🖼️ СЛОЙ С КАРТИНКОЙ -->
                                            <!-- ImageBrush заполнит весь фон. Opacity="0.15" сделает картинку полупрозрачной, 
                     чтобы она не перекрывала текст и сохраняла общую темную атмосферу. -->
                                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, 
                        Converter={StaticResource RadiusCalc}, ConverterParameter=-1.0}">
                                                <Border.Background>

                                                    <!-- 🔥 Сменили проект на SiberNet.UI и сделали правильный регистр папки Resourses! -->
                                                    <ImageBrush ImageSource="pack://application:,,,/SiberNet.UI;component/Resourses/68fadad90ca053b59b3e0178c4983607.png" 
                                                   Stretch="UniformToFill" 
                                                    Opacity="0.1"/>


                                                </Border.Background>
                                            </Border>

                                            <!-- КОНТЕНТ КАРТОЧКИ -->
                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



       





        <!-- 🎯 КИБЕРПАНК-СТИЛЬ ДЛЯ КРЕСТИКА ЗАКРЫТИЯ -->
        <Style x:Key="CyberpunkCloseButtonStyle" TargetType="Button">
            <!-- Убираем стандартный уродливый шаблон Windows -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFB300"/>
            <!-- Твой фирменный янтарный/оранжевый текст -->
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Хитрый Бордер: без границ, чтобы ловить мышку -->
                        <Border x:Name="BtnBorder" 
                            Background="{TemplateBinding Background}" 
                            BorderThickness="0"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- 🔴 ИДЕАЛЬНЫЙ ХОВЕР: При наведении мышки плашка становится малиновой, а крестик — белым -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FFF23E5C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- Эффект при нажатии (кнопка чуть темнеет) -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FFC2324A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


       <Style x:Key="CyberpunkWindowLaunchStyle" TargetType="Window">
    <!-- 🔥 ВОТ ЭТИ СЕТТЕРЫ МЫ ЗАБЫЛИ ДОБАВИТЬ! НАМЕРТВО ЗАПЕКАЕМ ТУТ 900х600 -->
    <Setter Property="Width" Value="900"/>
    <Setter Property="Height" Value="600"/>
    
    <!-- Невидимый бронежилет, чтобы окно нельзя было сжать меньше базового разрешения -->
    <Setter Property="MinWidth" Value="900"/>
    <Setter Property="MinHeight" Value="600"/>

    <!-- Твой старый пуленепробиваемый обвес хрома и прозрачности -->
    <Setter Property="WindowStyle" Value="None"/>
    <Setter Property="AllowsTransparency" Value="True"/>
    <Setter Property="Background" Value="Transparent"/>

    <!-- 🔥 БЕСПРОВОДНОЙ ПЕРЕТАСКИВАТЕЛЬ -->
    <Setter Property="WindowChrome.WindowChrome">
        <Setter.Value>
            <WindowChrome
                CaptionHeight="50" 
                ResizeBorderThickness="5" 
                GlassFrameThickness="0" 
                CornerRadius="0"/>
        </Setter.Value>
    </Setter>

    <Style.Triggers>
        <!-- 🚀 ВЗЛЕТ ПРИ СТАРТЕ -->
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation 
                        Storyboard.TargetProperty="Top"
                        From="1200" To="200" 
                        Duration="0:0:0.5"
                        DecelerationRatio="0.85"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Style.Triggers>
</Style>



        <!-- Обновленный киберпанк-стиль для обводки полей ввода с подсветкой фокуса -->
        <Style x:Key="CyberInputBorderStyle" TargetType="Border">
            <!-- Дефолтное состояние: неоновый Cyan #00F0FF -->
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Style.Triggers>
                <!-- 🟢 ТРИГГЕР 1: Если прилетел УСПЕХ -->
                <DataTrigger Binding="{Binding State}" Value="Success">
                    <Setter Property="BorderBrush" Value="#00FF66"/>
                </DataTrigger>

                <!-- 🔴 ТРИГГЕР 2: Если прилетела ОШИБКА -->
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="BorderBrush" Value="#F23E5C"/>
                </DataTrigger>

                <!-- 👑 ТРИГГЕР 3: ГЛАВНЫЙ ПРИОРИТЕТ — АКТИВНОЕ ПОЛЕ (ФОКУС) -->
                <!-- Мы смотрим на свойство IsKeyboardFocusWithin у самого Бордера. -->
                <!-- Оно автоматически становится True, если курсор стоит внутри встроенного TextBox! -->
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FFB300"/>
                    <!-- Можно даже сделать рамку чуть толще при фокусе, чтобы подчеркнуть активность -->
                    <Setter Property="BorderThickness" Value="1.2"/>
                </Trigger>
            </Style.Triggers>
        </Style>



        





      







        
        
        
        
        <!-- 2. НОВЫЙ НЕОНОВЫЙ СТИЛЬ ДЛЯ РЕГИСТРАЦИИ -->
        <Style x:Key="NeonRegistrationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <!-- ⚡️ Исправлено: рамка невидимая, но её толщина изначально 1, чтобы кнопка не дёргалась -->
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="MaxHeight" Value="35"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <!-- Неоновые голубые буквы по умолчанию -->
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.FontWeight="{TemplateBinding FontWeight}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- НАВЕДЕНИЕ: Вспыхивает неоновым зеленым (Больше ничего не двигается!) -->
                            <Trigger Property="IsMouseOver" Value="True">
                               <Setter TargetName="border" Property="Background" Value="#FFF23E5C"/>
<Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#00F0FF"/>
<Setter TargetName="border" Property="BorderBrush" Value="#00F0FF"/>
                                <!-- Толщину больше не переопределяем, она зафиксирована на 1 -->
                            </Trigger>

                            <!-- НАЖАТИЕ: Уход в глубокий кибер-синий -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF002B3D"/>
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#00F0FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00F0FF"/>
                            </Trigger>

                            <!-- ОТКЛЮЧЕННОЕ СОСТОЯНИЕ -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF404040"/>
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#FF615959"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- 🚀 ИМЕНОВАННЫЙ НЕОНОВЫЙ СТИЛЬ ДЛЯ TEXTBOX (С РАДИУСАМИ И ОТСТУПАМИ) -->
        <Style x:Key="NeonTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="0.5"/>

            <!-- Возвращаем человеческие отступы и высоту, чтобы текст не прилипал к краям -->
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,5,8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <!-- Неоновые буквы ввода и каретка -->
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="CaretBrush" Value="#00F0FF"/>

            <!-- Переопределяем шаблон, чтобы вернуть заветные скругления (CornerRadius) -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- Обертка поля с закруглением углов на 4 (или поставьте 5-6, как вам больше нравится) -->
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                            <!-- Область, где непосредственно отображается набираемый текст -->
                            <ScrollViewer x:Name="PART_ContentHost" 
                                  Focusable="false" 
                                  HorizontalScrollBarVisibility="Hidden" 
                                  VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <!-- ТРИГГЕР ОШИБКИ: Если цвет рамки меняется на малиновый, утолщаем до 2 -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=BorderBrush.Color}" Value="#FFF23E5C">
                    <Setter Property="BorderThickness" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>



        <Style x:Key="CyberpunkContactItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <!-- 🍊 СТАТИКА: Оранжево-золотые буквы по умолчанию -->
            <Setter Property="Foreground" Value="#FFB300"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        Padding="{TemplateBinding Padding}">
                            <!-- ContentPresenter сам выведет FirstName благодаря DisplayMemberPath -->
                            <ContentPresenter x:Name="contentPresenter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- 🚨 НАВЕДЕНИЕ КУРСОРA: Красный фон + Неоновый текст + Неоновая рамка -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF23E5C"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00F0FF"/>
                            </Trigger>

                            <!-- 🌌 АКТИВНЫЙ/ВЫБРАННЫЙ ЧАТ: Уход в глубокий темный с неоновой бирюзовой рамкой -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>

                            <!-- 🚫 ОТКЛЮЧЕННОЕ СОСТОЯНИЕ -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FF615959"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


      


        <!-- 1. ПОЛЕТ СВЕРХУ (Top) -->
        <Style x:Key="UniversalFlyOutTopStyle" TargetType="UserControl">
            <!-- Базовое состояние в космосе, чтобы не мешать кликам, пока закрыто -->
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="-600"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <!-- Слушаем ControlVisibility из твоей ViewModel напрямую через DataTrigger -->
                <DataTrigger Binding="{Binding ControlVisibility}" Value="Visible">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- 1. Мгновенно делаем видимым на экране -->
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <!-- 2. Плавно спускаем и проявляем -->
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" 
                                         From="-600" To="0" Duration="0:0:0.6" AccelerationRatio="0.2" DecelerationRatio="0.8"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                         From="0" To="1" Duration="0:0:1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>

                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- 1. Сначала плавно уносим наверх и гасим -->
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" 
                                         To="-600" Duration="0:0:0.5" AccelerationRatio="0.3" DecelerationRatio="0.7"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                         To="0" Duration="0:0:1"/>
                                <!-- 2. И только через 0.5 сек, когда форма уже в космосе, физически её гасим -->
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.5">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        

        <!-- 2. ПОЛЕТ СНИЗУ (Bottom) -->
        <Style x:Key="UniversalFlyOutBottomStyle" TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="600"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ControlVisibility}" Value="Visible">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" 
                                                 From="600" To="0" Duration="0:0:0.6" 
                                                 AccelerationRatio="0.2" DecelerationRatio="0.8"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                 To="600" Duration="0:0:1" AccelerationRatio="0.3" DecelerationRatio="0.7"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.5">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        

        <!-- 3. ПОЛЕТ СЛЕВА (Left) -->
        <Style x:Key="UniversalFlyOutLeftStyle" TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="-800"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ControlVisibility}" Value="Visible">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-800" To="0" Duration="0:0:0.6" AccelerationRatio="0.2" DecelerationRatio="0.8"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" To="-800" Duration="0:0:0.5" AccelerationRatio="0.3" DecelerationRatio="0.7"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.5">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>





        <Style x:Key="BorderedContentStyle" TargetType="ContentControl">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border 
                    BorderThickness="0.15" 
                            Margin="2.5, 5, 2.5, 5"
                           
                            BorderBrush="#00F0FF"
                    Padding="4"
                    CornerRadius="8" 
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                            <TextBlock
                        Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        FontSize="12"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>





      
        


        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#66ABC8AB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0,8,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                      CornerRadius="5"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Background="{TemplateBinding Background}">
                            <Grid Margin="5,0,0,0">
                                <ScrollViewer x:Name="PART_ContentHost"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="DimGray"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>

                </Setter.Value>
            </Setter>
        </Style>

        

       
        
        

        <Style x:Key="InnerBorderTitleStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border                        
                         BorderThickness="0.3"
                         BorderBrush="#00F0FF"
                         CornerRadius="8"
                         Background="#66ABC8AB">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
