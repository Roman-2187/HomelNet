<Window x:Class="SiberNet.UI.MainWindow"      
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converter="clr-namespace:SiberNet.UI.Converters"
        xmlns:controls="clr-namespace:SiberNet.UI.Controls" 
    mc:Ignorable="d"                                    
    AllowsTransparency="True"
    FontFamily="Calibri"
    FontSize="14"                             
   
            
    WindowStartupLocation="CenterScreen"         
    Style="{StaticResource CyberpunkWindowLaunchStyle}"
    DataContext="{Binding MainViewModel, Source={StaticResource ComponentHub}}">

    <Window.Resources>
        <!-- 🎯 ГЛАВНЫЙ МОСТ: Говорим окну использовать ваш оранжевый стиль как базовый -->
        <!-- Без этого моста кнопки сбрасывались в дефолтный серый дизайн Windows -->
        <Style TargetType="Button" BasedOn="{StaticResource OrangeDefaultButtonStyle}">
            <!-- Оставляем ваши точечные корректировки размеров для разметки главного окна -->
            <Setter Property="Padding" Value="9.4"/>
            <Setter Property="BorderThickness" Value="0.6"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
       
    </Window.Resources>


    <ContentControl Style="{StaticResource CyberpunkImageStyle}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
        <ContentControl.Tag>
            <CornerRadius>6</CornerRadius>
        </ContentControl.Tag>
        <Grid x:Name="MainGrid" Margin="4">
            <!-- Твоя шикарная 3-этажная сетка, которую мы утвердили! 🏢 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <!-- Этаж 0: Шапка TitleBar -->
                <RowDefinition Height="*"/>
                <!-- Этаж 1: Рабочая зона -->
                <RowDefinition Height="35"/>
                <!-- Этаж 2: Статус-бар -->
            </Grid.RowDefinitions>

            <!-- Колонку оставляем одну на 100% ширины по дефолту -->

            <!-- 👑 ЭТАЖ 0: ГЛОБАЛЬНЫЙ МОСТ ШАПКИ -->
            <!-- Повесили пропуск мыши WindowChrome ОДИН раз на весь Бордер! -->
            <Border Grid.Row="0" 
                Background="Transparent" 
                Height="40" 
                VerticalAlignment="Top"
                WindowChrome.IsHitTestVisibleInChrome="True">

                <!-- 🔥 САЖАЕМ НАШ КИБЕРПАНК-МОДУЛЬ ОДНОЙ СТРОЧКОЙ! -->
                <controls:TitleBarControl/>

            </Border>

            <!-- 🌌 ЭТАЖ 1: ЦЕНТРАЛЬНЫЙ РОУТЕР (Сюда будут влетать подэкраны по энумам) -->
            <ContentControl Grid.Row="1" 
                        Content="{Binding CurrentMainTab}"
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch"/>

            <!-- 📡 ЭТАЖ 2: НАШ РЕАКТИВНЫЙ СТАТУС-BAR -->
            <Border Grid.Row="2" Background="Transparent" Margin="5,0,5,5">
                <controls:StatusBarControl/>
            </Border>

        </Grid>

    </ContentControl>
</Window>




