<Window
    x:Class="SiberNet.UI.MainWindow"      
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:HomeNetPresentation.ViewModels;assembly=HomeNetPresentation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converter="clr-namespace:SiberNet.UI.Converters"
    xmlns:controls="clr-namespace:SiberNet.UI.Controls" 
    mc:Ignorable="d"                                    
    AllowsTransparency="True"
    FontFamily="Calibri"
    FontSize="14"                             
   
            
    WindowStartupLocation="CenterScreen"         
    Style="{StaticResource CyberpunkWindowLaunchStyle}"
   
    DataContext="{Binding MainViewModel, Source={StaticResource ComponentHub}}">

    <Window.Resources>
        <!-- 🎯 ГЛАВНЫЙ МОСТ: Говорим окну использовать ваш оранжевый стиль как базовый -->
        <Style TargetType="Button" BasedOn="{StaticResource OrangeDefaultButtonStyle}">
            <Setter Property="Padding" Value="9.4"/>
            <Setter Property="BorderThickness" Value="0.6"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <!-- Твой верхний фоновый киберпанк-контейнер -->
    <ContentControl Style="{StaticResource CyberpunkImageStyle}" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch">
        <ContentControl.Tag>
            <CornerRadius>6</CornerRadius>
        </ContentControl.Tag>

        <!-- НАША РОДНАЯ СЕТКА С ТРЕМЯ ЭТАЖАМИ 🏢 -->
        <Grid x:Name="MainGrid" Margin="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Этаж 0: Шапка TitleBar -->
                <RowDefinition Height="*"/>
                <!-- Этаж 1: Рабочая зона -->
                <RowDefinition Height="Auto"/>
                <!-- Этаж 2: Статус-бар -->
            </Grid.RowDefinitions>

            <!-- 👑 ЭТАЖ 0: ГЛОБАЛЬНЫЙ МОСТ ШАПКИ (Твой TitleBarControl) -->
            <Border Grid.Row="0" 
                    Background="Transparent" 
                    Height="40" 
                    VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <controls:TitleBarControl/>
            </Border>

            <!-- 🌌 ЭТАЖ 1: ЦЕНТРАЛЬНЫЙ СЛЕСАРНЫЙ ШЛЮЗ (Разделен на 2 горизонтальные колонки) -->
            <Grid Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <!-- Левая колонка: Жестко 900px для мессенджера/админки, чтобы ничего не ехало -->
                    <ColumnDefinition Width="900"/>
                    <!-- Правая колонка: Забирает все остальное пространство под терминал логов -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <!-- КАРТА ШКУР: Связываем ВьюМодели с их реальными UI-контролами -->
                    <DataTemplate DataType="{x:Type vm:AuthenticationViewModel}">
                        <controls:AuthenticationViewControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:RegistrationViewModel}">
                        <controls:RegistrationViewControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:AdminMenuViewModel}">
                        <controls:AdminMenu HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </DataTemplate>
                    
                    

                    <DataTemplate DataType="{x:Type vm:UserDashboardViewModel}">
                        <controls:UserDashboardControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </DataTemplate>
                </Grid.Resources>

                <!-- 👤 ЛЕВАЯ ЗОНА (Column="0"): Полностью управляется через сквозной Navigation -->
                <ContentControl Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <!-- По умолчанию на старте холст чист, ждём выбора пользователя -->
                            <Setter Property="Content" Value="{x:Null}"/>
                            <Style.Triggers>
                                <!-- 🔑 ЭТАП 1 ЮЗЕРА: Нажали вход — выкатываем форму авторизации -->
                                <DataTrigger Binding="{Binding Navigation.CurrentClientTab}" Value="Authentication">
                                    <Setter Property="Content" Value="{Binding AuthenticationViewModel, Source={StaticResource ComponentHub}}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Navigation.CurrentMainZone}" Value="AdminZone">
                                    <Setter Property="Content" Value="{Binding AdminMenuViewModel, Source={StaticResource ComponentHub}}"/>
                                </DataTrigger>

                                <!-- 📝 ЭТАП 1 ЮЗЕРА: Нажали регистрацию — выкатываем форму регистрации -->
                                <DataTrigger Binding="{Binding Navigation.CurrentClientTab}" Value="Registration">
                                    <Setter Property="Content" Value="{Binding RegistrationViewModel, Source={StaticResource ComponentHub}}"/>
                                </DataTrigger>

                                <!-- 💬 ЭТАП 2 ЮЗЕРА: Форма получила УСПЕХ — переключаемся на дашборд мессенджера -->
                                <DataTrigger Binding="{Binding Navigation.CurrentMainZone}" Value="ClientZone">
                                    <Setter Property="Content" Value="{Binding UserDashboardViewModel, Source={StaticResource ComponentHub}}"/>
                                </DataTrigger>

                               
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <!-- ⚡ ПРАВАЯ ЗОНА (Column="1"): Выдвижной терминал логов админки -->
                <!-- Показываем её на экране, только если админ зашёл в свою макро-зону! -->
                <ContentControl Grid.Column="1" 
                                Content="{Binding AdminMenuViewModel, Source={StaticResource ComponentHub}}"
                                HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- Логи выезжают шторкой только когда макро-зона переключена в AdminZone -->
                                <DataTrigger Binding="{Binding Navigation.CurrentMainZone}" Value="AdminZone">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>

            <!-- 📡 ЭТАЖ 2: НАШ РЕАКТИВНЫЙ СТАТУС-BAR -->
            <Border Grid.Row="2" Background="Transparent" Margin="5,0,5,5">
                <controls:StatusBarControl/>
            </Border>
        </Grid>
    </ContentControl>
</Window>


