<Window
    x:Class="SiberNet.UI.MainWindow"      
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:HomeNetPresentation.ViewModels;assembly=HomeNetPresentation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converter="clr-namespace:SiberNet.UI.Converters"
    xmlns:controls="clr-namespace:SiberNet.UI.Controls" 
    mc:Ignorable="d"                                           
    WindowStartupLocation="CenterScreen"         
    Style="{StaticResource CyberpunkWindowLaunchStyle}">

    <Window.Resources>
        <Style TargetType="Button"
               BasedOn="{StaticResource OrangeDefaultButtonStyle}">
            <Setter Property="Padding" Value="1.4"/>
            <Setter Property="BorderThickness" Value="0.6"/>
        </Style>
    </Window.Resources>


    <ContentControl 
        Style="{StaticResource CyberpunkImageStyle}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch" Tag="8">


        <!-- Разметка Майна сократилась до двух элементов! 🏢 -->
        <Grid x:Name="MainGrid" Margin="0" 
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="881*"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>
                <!-- Строка 1: Статус-бар внизу -->
            </Grid.RowDefinitions>

            <!-- 👑 ТАЙТЛ-БАР ЗАБРАЛ СЕБЕ СТРОКУ И УПРАВЛЯЕТ ВСЕМ ВНУТРИ -->
            <controls:TitleBarControl 
                Grid.Row="0" Grid.ColumnSpan="2"/>

            <!-- 📡 СТАТУС-BAR ОСТАЛСЯ СНИЗУ -->
            <Border
                Grid.Row="1"
                Background="Transparent" Grid.ColumnSpan="2">
                <controls:StatusBarControl Height="40"/>
            </Border>
        </Grid>
    </ContentControl>
</Window>


