<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:di="using:HomeNet.DI"
             xmlns:models="using:HomeNetCore.Models"
             xmlns:vm="using:HomeNetPresentation.ViewModels.AdminViews"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="HomeNetAvalonia.Controls.DeleteUsersControl"
            
             x:DataType="di:ComponentHub">

       
    <ContentControl DataContext="{StaticResource ComponentHub}" x:CompileBindings="False">
        
        <!-- 🔥 А вот здесь включаем жесткую типизацию обратно, но уже СТРОГО для вьюмодели удаления! -->
        <Grid DataContext="{Binding DeleteUsersViewModel}" >
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" >
                <Grid.ColumnDefinitions>
                    <!-- Бан сжатия левой части меньше 200 -->
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= ЛЕВАЯ ЧАСТЬ (ЕДИНЫЙ ГРИД) ================= -->
                <Grid Grid.Column="0" Margin="0,0,5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 👑 ЗАГОЛОВОК -->
                    <TextBlock Grid.Row="0"
                               Text="Удаление учетных записей"
                               Foreground="#FFF5546F"
                               FontWeight="Bold" 
                               FontSize="14"
                               Margin="0,5,0,5"
                               VerticalAlignment="Center"/>

                    <!-- Панель поиска -->
                    <Grid Grid.Row="1" Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"  />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- В Авалонии по умолчанию текст обновляется сразу, 
                             так что UpdateSourceTrigger писать не нужно -->
                        <TextBox Text="{Binding TargetUserId}"
                                 Grid.Column="0"
                                 BorderBrush="#FF211E19"
                                 BorderThickness="0.5"
                                 HorizontalAlignment="Stretch" 
                                 Height="35"
                                 VerticalContentAlignment="Center"
                                 Foreground="#FFF5546F"
                                 Padding="5,0,0,0"
                                 Background="#1AADD8E6"/>

                        <Button Content="Найти" 
                                Grid.Column="1"
                                Width="90" Height="35"
                                Margin="10,0,0,0"
                                Command="{Binding SearchCommand}"
                                Background="Transparent" />
                    </Grid>

                    <!-- Живой список пользователей -->
                    <Border Grid.Row="2"
                            Background="#1AADD8E6"
                            BorderBrush="#FFF5546F"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        
                        <!-- В Авалонии нет DisplayMemberPath, используем ItemTemplate -->
                        <ListBox BorderThickness="0"
                                 ItemsSource="{Binding FoundUsers}"
                                 SelectedItem="{Binding SelectedUser}"
                                 Background="Transparent"
                                 Margin="10" 
                                 Foreground="#FFF5546F">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:UserEntity">
                                    <!-- Биндим твоё вычисляемое свойство информации о юзере -->
                                    <TextBlock Text="{Binding DisplayInfo}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <!-- 🔥 КИБЕРПАНК-РАЗДЕЛИТЕЛЬ АВАЛОНИИ -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"
                              Background="#6600FFFF" 
                              Margin="3,0,3,0"/>

                <!-- ================= ПРАВАЯ ЧАСТЬ (ЖУРНАЛ ИСТОРИИ) ==-->
                <Border Grid.Column="2"               
                        Margin="5,30,0,0"
                        BorderThickness="0"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Журнал истории удаления (Текущая сессия)"
                                   Foreground="#FFF5546F"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="10,10,10,5"/>

                        <Border Grid.Row="1"        
                                Background="#1AADD8E6"
                                Margin="5,25,0,0"
                                BorderThickness="0"
                                CornerRadius="6"
                                ClipToBounds="True">
                            
                            <!-- Отключаем выделение элементов в истории, чтобы лог был только для чтения -->
                            <ListBox ItemsSource="{Binding DeletedUsersHistory}"
                                     Background="Transparent"
                                     Margin="10,10"  
                                     BorderThickness="0" 
                                     Foreground="#00F0FF"
                                     IsHitTestVisible="False"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 🔥 НИЖНЯЯ ПАНЕЛЬ СТАТУСА И УПРАВЛЕНИЯ -->
            <Grid Grid.Row="1" Margin="15,10,15,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="#FFF5546F"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="0,0,20,0"/>

                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="80" Height="35"
                            Content="Удалить" 
                            Margin="0,0,10,0"
                            Command="{Binding ExecuteDeleteCommand}"
                            Background="Transparent" />

                    <Button Width="80" Height="35"
                            Content="Отмена"
                            Command="{Binding CancelCommand}"
                            Background="Transparent" />
                </StackPanel>
            </Grid>
        </Grid>
    </ContentControl>
</UserControl>
