<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:controls="using:HomeNetAvalonia.Controls"
             xmlns:vm="using:HomeNetPresentation.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="500"
             x:Class="HomeNetAvalonia.Controls.ContactsListViewControl"
             x:DataType="vm:ContactsViewModel">

    <!-- 🌌 Глобальный DataContext Хаба для полной автономности контрола -->
    <ContentControl
        DataContext="{DynamicResource ComponentHub}"
        x:CompileBindings="False">
        
        <!-- 🦾 Автоматически проваливаемся в родную ContactsViewModel -->
        <Grid DataContext="{Binding ContactsViewModel}" RowDefinitions="Auto, *">
            
                      <!-- 🍔 ВЕРХНЯЯ ЧАСТЬ: Кнопка управления, выхода и имя текущего кибер-юзера -->
            <Border Grid.Row="0" Background="#1100F0FF" BorderBrush="#3300F0FF" BorderThickness="0,0,0,1" Padding="5" Margin="5,5,5,0">
                <Grid ColumnDefinitions="Auto, *">
                    <!-- Родное меню логаута -->
                    <controls:AccountMenuControl Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    
                    <!-- 👤 ПЛАШКА ТЕКУЩЕГО ПОЛЬЗОВАТЕЛЯ -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,0,5,0">
                        <TextBlock Text="СЕТЬ:" Foreground="#5500F0FF" FontSize="11" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentUserName, FallbackValue='Авторизация...'}" 
                                   Foreground="#FF00AA" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   VerticalAlignment="Center"/>
                        <!-- Маленькая неоновая точка статуса -->
                        <Ellipse Width="8" Height="8" Fill="#00FF66" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- 👥 НИЖНЯЯ ЧАСТЬ: Настоящий список контактов -->
            <Border Grid.Row="1" Background="#2200F0FF" BorderBrush="#00F0FF" BorderThickness="1" Margin="5">
                <ListBox ItemsSource="{Binding Friends}" 
                         SelectedItem="{Binding SelectedFriend, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="5">
                                <Ellipse Width="32" Height="32" Fill="#00F0FF" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FirstName}" 
                                           Foreground="#00F0FF" 
                                           VerticalAlignment="Center" 
                                           FontSize="14"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            
        </Grid>
    </ContentControl>
</UserControl>
