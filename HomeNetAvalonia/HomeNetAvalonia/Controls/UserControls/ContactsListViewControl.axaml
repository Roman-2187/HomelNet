<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:controls="using:HomeNetAvalonia.Controls"
             xmlns:vm="using:HomeNetPresentation.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="500"
             x:Class="HomeNetAvalonia.Controls.ContactsListViewControl"
             x:DataType="vm:ContactsViewModel">

    <!-- 🌌 Глобальный DataContext Хаба для полной автономности контрола -->


   
  <ContentControl Classes="AccountMenuContainer" 
    DataContext="{DynamicResource ComponentHub}" 
    x:CompileBindings="False" >
    
    <!-- 🦾 Автоматически проваливаемся в родную ContactsViewModel -->
    <!-- 🔥 Задаем RowDefinitions="*", чтобы этот Grid растянулся на всё пространство -->
    <Grid Background="#10ADD8E6"
        DataContext="{Binding ContactsViewModel}"
        RowDefinitions="*">
        
      
        
        <!-- 🛡️ ЕДИНЫЙ КИБЕР-КОНТЕЙНЕР ДЛЯ ПАНЕЛИ КОНТАКТОВ -->
       
            
            <!-- 🔥 Внутренний Grid с двумя строками -->
            <Grid RowDefinitions="Auto, *">  
                
                
                <!-- 🍔 ВЕРХНЯЯ ЧАСТЬ: Кнопка управления, выхода и имя текущего юзера -->
                <Border 
                    Grid.Row="0"
                    Background="#1100F0FF"
                    BorderBrush="#3300F0FF"
                    
                    CornerRadius="2"
                    Padding="5" >
                    <Grid ColumnDefinitions="Auto, *">

                         <Button Content="☰"
                        
                        Padding="8,3"
                        FontSize="14"
                        Command="{Binding  ToggleMenuCommand}" />


                     
                        
                        <StackPanel
                            Height="35"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8" Margin="0,0,5,0">
                            <TextBlock
                                Text="СЕТЬ:"
                                Foreground="#5500F0FF"
                                FontSize="11" VerticalAlignment="Center"
                                FontWeight="Bold"/>
                            <TextBlock
                                Text="{Binding CurrentUserName, FallbackValue='Авторизация...'}" 
                                
                                FontWeight="Bold" 
                                FontSize="13" 
                                VerticalAlignment="Center"/>
                            <Ellipse 
                                Width="8"
                                Height="8" 
                                Fill="#00FF66"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 👥 НИЖНЯЯ ЧАСТЬ: Список контактов -->
                <!-- 🔥 Строка "*" заставит ListBox занять всё оставшееся место -->
  <ListBox 
    Grid.Row="1"
    ItemsSource="{Binding Friends}" 
    SelectedItem="{Binding SelectedFriend, Mode=TwoWay}"
    Background="Transparent"
    BorderThickness="0"
    Margin="0,2,0,0">
  <ListBox.ItemContainerTheme>
    <!-- 
      🔥 ControlTheme задает правила отрисовки для КАЖДОГО элемента списка (ListBoxItem).
      BasedOn="{StaticResource {x:Type ListBoxItem}}" означает: 
      "Возьми базовую тему Avalonia и немного переопредели её".
    -->
    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        
        <!-- 
          🔹 Базовое состояние (когда элемент НЕ выделен и НЕ наведен).
          Background="Transparent" — фон прозрачный, чтобы был виден фон самого ListBox.
          Padding="5" — внутренний отступ, чтобы текст не прилипал к краям.
        -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="5"/>

        <!-- 
          🔥 СТАТИК (Выделенный элемент). 
          Срабатывает, когда ты кликаешь по элементу (он становится SelectedItem).
          Selector="^:selected" означает "текущий элемент в состоянии selected".
          Мы меняем Background (фон) и BorderBrush (цвет рамки).
          BorderThickness="1,0,0,0" рисует рамку только слева (толщина 1 пиксель).
        -->
       <Style Selector="^:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1100F0FF" />
            <Setter Property="BorderBrush" Value="#00F0FF" />   <!-- Яркий голубой для полоски -->
            <Setter Property="BorderThickness" Value="0.4,0,0,0" />
            <Setter Property="CornerRadius" Value="2" /> <!-- Полоска только слева -->
        </Style>

        <!-- 
          🔥 НАВЕДЕНИЕ (Hover).
          Срабатывает, когда ты просто наводишь мышку на элемент, но НЕ кликнул.
          Selector="^:pointerover" означает "текущий элемент в состоянии pointerover".
          Мы делаем фон чуть более заметным, но менее ярким, чем выделение.
        -->
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="#1500F0FF" />
                <Setter Property="CornerRadius" Value="2" /> 
<!-- Очень прозрачный голубой -->
        </Style>
        
        <!-- 
          💡 Если хочешь, чтобы при наведении на ВЫДЕЛЕННЫЙ элемент фон не перебивался 
          на менее яркий, можно добавить комбинированный селектор:
          <Style Selector="^:selected:pointerover">
              <Setter Property="Background" Value="#3300F0FF" />
          </Style>
          Но в текущей логике ListBoxItem:pointerover может перебить :selected, 
          если они идут в таком порядке. Если фон при наведении на выделенный элемент 
          становится тусклым, поменяй их местами (сначала pointerover, потом selected).
        -->

    </ControlTheme>
</ListBox.ItemContainerTheme>

   <ListBox.ItemTemplate>
    <DataTemplate>
        <TextBlock 
            Text="{Binding FirstName}" 
            Foreground="#00F0FF" 
            FontSize="15" 
            Padding="15,8" />
    </DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
    
   
                
            </Grid>
        <controls:SideMenuControl
                        HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>
        
    </Grid>

       
</ContentControl>
</UserControl>
