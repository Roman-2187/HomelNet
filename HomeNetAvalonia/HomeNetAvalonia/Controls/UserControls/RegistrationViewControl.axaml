<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:di="using:HomeNet.DI"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
             x:Class="HomeNetAvalonia.Controls.RegistrationViewControl"
             x:DataType="di:ComponentHub" Width="600" Height="450"
             > 
    
  <!-- 🧼 СТИЛИ УШЛИ В РЕСУРСЫ, ТУТ ЧИСТАЯ РАЗМЕТКА -->

   <ContentControl Classes="CyberpunkInnerContainer" Padding="50,35,50,20" 
            DataContext="{DynamicResource ComponentHub}"
            x:CompileBindings="False"  
           >
        
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, 80"
              DataContext="{Binding RegistrationViewModel}">

            <!-- 0️⃣ USER NAME -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Имя пользователя:" Foreground="#00CCFF" 
                           Margin="0,0,0,4" FontSize="12"/>
                <TextBox Classes="validation-box"
                         Text="{Binding UserData.FirstName, Mode=TwoWay}"
                         Tag="{Binding ValidationResults[NameType].State}" />
                <TextBlock Classes="validation-hint"
                           Text="{Binding ValidationResults[NameType].Message}"
                           Tag="{Binding ValidationResults[NameType].State}" />
            </StackPanel>

            <!-- 1️⃣ EMAIL -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Email:" Foreground="#00CCFF" Margin="0,0,0,4" FontSize="12"/>
                <TextBox Classes="validation-box"
                         Text="{Binding UserData.Email, Mode=TwoWay}"
                         Tag="{Binding ValidationResults[EmailType].State}" />
                <TextBlock Classes="validation-hint"
                           Text="{Binding ValidationResults[EmailType].Message}"
                           Tag="{Binding ValidationResults[EmailType].State}" />
            </StackPanel>

            <!-- 2️⃣ PASSWORD -->
            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Пароль:" Foreground="#00CCFF" Margin="0,0,0,4" FontSize="11"/>
                <TextBox Classes="validation-box"
                         Text="{Binding UserData.Password, Mode=TwoWay}" 
                         Tag="{Binding ValidationResults[PasswordType].State}" />
                <TextBlock Classes="validation-hint"
                           Text="{Binding ValidationResults[PasswordType].Message}"
                           Tag="{Binding ValidationResults[PasswordType].State}" />
            </StackPanel>

            <!-- 3️⃣ CONFIRMED PASSWORD -->
            <StackPanel Grid.Row="3" Margin="0,0,0,5">
                <TextBlock Text="Повторите пароль:" Foreground="#00CCFF" Margin="0,0,0,4" FontSize="11"/>
                <TextBox Classes="validation-box"
                         Text="{Binding UserData.ConfirmPassword, Mode=TwoWay}" 
                         Tag="{Binding ValidationResults[ConfirmedPasswordType].State}" />
                <TextBlock Classes="validation-hint"
                           Text="{Binding ValidationResults[ConfirmedPasswordType].Message}"
                           Tag="{Binding ValidationResults[ConfirmedPasswordType].State}" />
            </StackPanel>

            <!-- 4️⃣ НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ -->
            <Grid Grid.Row="4" ColumnDefinitions="*, Auto" >
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" 
                           Foreground="#00CCFF" VerticalAlignment="Center" FontSize="11"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <!-- 🔥 ОЖИВИЛИ КНОПКИ: накинули классы нашего глобального киберпанк-стиля -->
                    <Button Content="Отмена" 
                            Classes="cyber-btn form-btn" 
                            Command="{Binding CancelCommand}" Foreground="#00CCFF"
                            Margin="0,0,15,0"/>
                    
                    <Button Content="{Binding SubmitButtonText}" 
                            Classes="cyber-btn form-btn" Foreground="#00CCFF"
                            Command="{Binding RegisterCommand}"/>
                    
                </StackPanel>
            </Grid>

        </Grid>
   </ContentControl>
</UserControl>
