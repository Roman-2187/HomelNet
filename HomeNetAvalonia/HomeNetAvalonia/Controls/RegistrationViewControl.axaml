<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:di="using:HomeNet.DI"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
             x:Class="HomeNetAvalonia.Controls.RegistrationViewControl"
             x:DataType="di:ComponentHub" Width="600" Height="500"
             > 
    
 <UserControl.Styles>
        <!-- 🎨 ПОДСКАЗКИ В ЦЕНТРЕ -->
        <Style Selector="TextBlock.validation-hint">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style Selector="TextBlock.validation-hint[Tag=Error]">
            <Setter Property="Foreground" Value="#FFF5546F"/>
        </Style>
        <Style Selector="TextBlock.validation-hint[Tag=Success]">
            <Setter Property="Foreground" Value="#00E666"/>
        </Style>

       
        <Style Selector="TextBox.validation-box /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#11141A"/>
            <Setter Property="BorderBrush" Value="#304050"/>
          
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        
       
        <Style Selector="TextBox.validation-box:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#00F0FF"/>
        </Style>
        <Style Selector="TextBox.validation-box:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="Background" Value="#11141A"/>
        </Style>

       
        <Style Selector="TextBox.validation-box[Tag=Error] /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#FFF5546F"/>
        </Style>
        <Style Selector="TextBox.validation-box[Tag=Success] /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#00E666"/>
        </Style>
    </UserControl.Styles>

    <Border Padding="50,30,50,20" 
            DataContext="{DynamicResource ComponentHub}"
            x:CompileBindings="False"
            Background="#1A1F29" 
            BorderBrush="#304050"
            BorderThickness="1"
            CornerRadius="6">
        
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, 80"
              DataContext="{Binding RegistrationViewModel}">

            <!-- 0️⃣ USER NAME -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="Имя пользователя:" Foreground="#00F0FF" 
                           Margin="0,0,0,4" FontSize="12"/>
                <TextBox Classes="validation-box"
                         Text="{Binding UserData.FirstName, Mode=TwoWay}"
                         Tag="{Binding ValidationResults[NameType].State}" />
                <TextBlock Classes="validation-hint"
                           Text="{Binding ValidationResults[NameType].Message}"
                           Tag="{Binding ValidationResults[NameType].State}" />
            </StackPanel>

            <!-- 1️⃣ EMAIL -->
            <StackPanel Grid.Row="1" Margin="0,0,0,25">
                <TextBlock Text="Email:" Foreground="#00F0FF" Margin="0,0,0,4" FontSize="12"/>
                <TextBox Classes="validation-box"
                         Text="{Binding UserData.Email, Mode=TwoWay}"
                         Tag="{Binding ValidationResults[EmailType].State}" />
                <TextBlock Classes="validation-hint"
                           Text="{Binding ValidationResults[EmailType].Message}"
                           Tag="{Binding ValidationResults[EmailType].State}" />
            </StackPanel>

            <!-- 2️⃣ PASSWORD -->
            <StackPanel Grid.Row="2" Margin="0,0,0,25">
                <TextBlock Text="Пароль:" Foreground="#00F0FF" Margin="0,0,0,4" FontSize="12"/>
                <TextBox Classes="validation-box"
                         Text="{Binding UserData.Password, Mode=TwoWay}" 
                         PasswordChar="*"
                         Tag="{Binding ValidationResults[PasswordType].State}" />
                <TextBlock Classes="validation-hint"
                           Text="{Binding ValidationResults[PasswordType].Message}"
                           Tag="{Binding ValidationResults[PasswordType].State}" />
            </StackPanel>

            <!-- 3️⃣ CONFIRMED PASSWORD -->
            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <TextBlock Text="Повторите пароль:" Foreground="#00F0FF" Margin="0,0,0,4" FontSize="12"/>
                <TextBox Classes="validation-box"
                         Text="{Binding UserData.ConfirmPassword, Mode=TwoWay}" 
                         PasswordChar="*"
                         Tag="{Binding ValidationResults[ConfirmedPasswordType].State}" />
                <TextBlock Classes="validation-hint"
                           Text="{Binding ValidationResults[ConfirmedPasswordType].Message}"
                           Tag="{Binding ValidationResults[ConfirmedPasswordType].State}" />
            </StackPanel>

            <!-- 4️⃣ НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ -->
            <Grid Grid.Row="4" ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#00F0FF" VerticalAlignment="Center" FontSize="13"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Margin="0,0,20,0" BorderThickness="0.4"
                            BorderBrush="#304050" Background="#252A36" Foreground="#FFFFFF" CornerRadius="6" Padding="20,8"/>
                    <Button Content="{Binding SubmitButtonText}" Command="{Binding RegisterCommand}" BorderThickness="0.4"
                            BorderBrush="#304050" Background="#252A36" Foreground="#FFFFFF" CornerRadius="6" Padding="20,8"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
