<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="50"
             x:Class="HomeNetAvalonia.Controls.StatusBarControl"
              xmlns:vm="using:HomeNetPresentation.ViewModels"
              x:DataType="vm:StatusBarViewModel" Background="Transparent">
   <Border Background="#FF1C2433" Margin="5"
            BorderBrush="#304050" 
            BorderThickness="0.5" 
            CornerRadius="2" 
            VerticalAlignment="Stretch" 
            HorizontalAlignment="Stretch">
        
        <Grid VerticalAlignment="Center" ColumnDefinitions="*, Auto">
            
            <!-- Левый оригинальный розовый текст событий -->
            <TextBlock
                Grid.Column="0"
                Text="{Binding StatusText, FallbackValue='Загрузка системы...'}"
                Margin="0" 
                Padding="15,0,0,0"
                FontWeight="Light"
                Foreground="#FFF5546F"
                VerticalAlignment="Center"/>

            <!-- Правый аскетичный индикатор бортового компьютера -->
            <StackPanel 
                Grid.Column="1"
                Orientation="Horizontal" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Center" 
                Background="Transparent"
                Margin="0,0,15,0">
                
                <!-- 🔥 ЖЕЛЕЗОБЕТОННЫЙ БИНДИНГ ЦВЕТА НАПРЯМУЮ ВО ВЬЮМОДЕЛЬ -->
                <TextBlock 
                    Name="NetworkIndicator"
                    Text="{Binding CombinedStatusText, FallbackValue='OFFLINE'}" 
                    Foreground="{Binding StatusColor}" 
                    FontFamily="Consolas" 
                    FontSize="11" 
                    FontWeight="Bold"
                    VerticalAlignment="Center"/>
                    
            </StackPanel>
        </Grid>
    </Border>
       
</UserControl>
