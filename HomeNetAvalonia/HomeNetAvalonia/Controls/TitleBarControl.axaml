<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:enums="using:HomeNetCore.Enums.Navigation"
    xmlns:vm="using:HomeNetPresentation.ViewModels"
    xmlns:conv="using:HomeNetAvalonia.Converters"
    xmlns:di="using:HomeNet.DI" 
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" 
   
    x:Class="HomeNetAvalonia.Controls.TitleBarControl"        
    x:DataType="di:ComponentHub">
    
    

  <UserControl.Resources>
        <conv:EqualityConverter x:Key="EqualityConverter"/>
        
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Базовый стиль для всех кнопок в этой панели управления -->
        <Style Selector="StackPanel.control-panel Button">
            <Setter Property="Background" Value="#FF1B222E"/>
            <Setter Property="BorderBrush" Value="#40F5546F"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- Стиль для стандартных широких кнопок действий (Админка, Вход...) -->
        <Style Selector="StackPanel.control-panel Button.action-btn">
            <Setter Property="Width" Value="110"/>
        </Style>

        <!-- Стиль для эффекта наведения (Hover) -->
        <Style Selector="StackPanel.control-panel Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF253042"/>
            <Setter Property="BorderBrush" Value="#40F5546F"/>
        </Style>
        
        <!-- 🔥 ВСЕ ПРОБЛЕМНЫЕ СЕЛЕКТОРЫ С DATACONTEXT ПОЛНОСТЬЮ УДАЛЕНЫ ОТСЮДА -->
    </UserControl.Styles>

    <!-- Корневой Грид, завязанный на ComponentHub -->
   <Grid DataContext="{DynamicResource ComponentHub}"
          x:DataType="di:ComponentHub"
          x:CompileBindings="True"> 
        
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 👑 ВЕРХНЯЯ ПАНЕЛЬ ШАПКИ -->
        <!-- А здесь мы переключаем контекст типов строго на вьюмодель шапки -->
        <Grid Grid.Row="0" 
              DataContext="{Binding TitleBarViewModel}"
              x:DataType="vm:TitleBarViewModel"
              Background="Transparent">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- НАЗВАНИЕ ПРИЛОЖЕНИЯ -->
            <TextBlock
                Grid.Column="0"
                Text="SIBERNET v1.0"
                Foreground="#FFF5546F"
                VerticalAlignment="Center"
                Margin="15,0,0,0"
                FontWeight="Bold"/>

            <!-- ЕДИНЫЙ ПУЛЬТ УПРАВЛЕНИЯ СПРАВА -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="0,0,15,0"
                Classes="control-panel">
                
                <!-- 🔥 ЧИСТЫЙ И БЕЗОПАСНЫЙ КОНТРОЛЬ СВЕТА ЧЕРЕЗ МУЛЬТИ-БИНДИНГ -->
                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,0,10,0">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding 
                                Path="CurrentMainZone"
                                Converter="{StaticResource EqualityConverter}"
                                ConverterParameter="{x:Static enums:MainTab.StartZone}"/>
                            <Binding
                                Path="CurrentClientTab" 
                                Converter="{StaticResource EqualityConverter}"
                                ConverterParameter="{x:Static enums:ClientSubTab.None}"/>
                        </MultiBinding>
                    </StackPanel.IsVisible>
                 
                    <Button
                        Content="🛠️ Админка"
                        Classes="action-btn"
                        Margin="0,0,20,0"
                        Command="{Binding ToggleAdminZoneCommand}" />
                    <Button 
                        Content="🔑 Вход"
                        Classes="action-btn"
                        Margin="0,0,10,0"
                        Command="{Binding OpenAuthZoneCommand}"/>
                    <Button
                        Content="📝 Регистрация" 
                        Classes="action-btn"
                        Command="{Binding OpenRegisterZoneCommand}"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <Button
                        Content="🔳"
                        Command="{Binding ToggleGrowWindowCommand}"
                        Margin="0,0,5,0"/>
                    <Button
                        Content="✕"
                        Command="{Binding RequestCloseApplicationCommand}"
                        Width="30" />
                </StackPanel>
                
            </StackPanel>
        </Grid>

        <!-- 🌌 ВЛАСТЬ НАД ЦЕНТРАЛЬНЫМ ХОЛСТОМ -->
        <Grid 
            Grid.Row="1"
             DataContext="{Binding TitleBarViewModel}" 
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Margin="0,0,0,5"
            x:DataType="vm:TitleBarViewModel">
            
            <!-- Экран А: Форма Входа -->
            <Border
                x:Name="AuthScreenContainer"
                Background="Transparent"
                IsVisible="{Binding CurrentClientTab, 
                Converter={StaticResource EqualityConverter},
                ConverterParameter={x:Static enums:ClientSubTab.Authentication}}">
                <TextBlock
                    Text="[ЭКРАН АВТОРИЗАЦИИ]"
                    Foreground="#00F0FF"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"/>
            </Border>

            <!-- Экран Б: Панель Администратора -->
            <Border
                x:Name="AdminScreenContainer"
                Background="Transparent"
                IsVisible="{Binding CurrentMainZone, 
                Converter={StaticResource EqualityConverter},
                ConverterParameter={x:Static enums:MainTab.AdminZone}}">
                <TextBlock
                    Text="[ПАНЕЛЬ АДМИНИСТРАТОРА]"
                    Foreground="#00F0FF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>

            <!-- Экран В: Форма Регистрации -->
            <Border
                x:Name="RegisterScreenContainer"
                Background="Transparent"
                IsVisible="{Binding CurrentClientTab,
                Converter={StaticResource EqualityConverter},
                ConverterParameter={x:Static enums:ClientSubTab.Registration}}">
                <TextBlock
                    Text="[ФОРМА РЕГИСТРАЦИИ]"
                    Foreground="#00F0FF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>

            <!-- Экран Г: Рабочая Зона Пользователя -->
            <Border
                x:Name="UserScreenContainer"
                Background="Transparent"
                IsVisible="{Binding CurrentMainZone,
                Converter={StaticResource EqualityConverter},
                ConverterParameter={x:Static enums:MainTab.ClientZone}}">
                <TextBlock
                    Text="[РАБОЧАЯ ЗОНА МЕССЕНДЖЕРА SIBERNET]" 
                    Foreground="#00F0FF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
 
</UserControl>
