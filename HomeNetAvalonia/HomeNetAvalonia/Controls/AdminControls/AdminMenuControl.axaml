<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            
             xmlns:controls="using:HomeNetAvalonia.Controls"
             xmlns:conv="using:HomeNetAvalonia.Converters"
             xmlns:enums="using:HomeNetCore.Enums.Navigation"
             x:Class="HomeNetAvalonia.Controls.AdminMenuControl"
             mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="500">

    <UserControl.Resources>
        <conv:EqualityConverter x:Key="EqualityConverter"/>
    </UserControl.Resources>

    <!-- 🌌 Глобальный DataContext Хаба для рантайма без Code-behind -->
    <ContentControl
        DataContext="{DynamicResource ComponentHub}"
        x:CompileBindings="False">
        
        <!-- 🦾 Автоматически проваливаемся в AdminViewModel -->
        <Grid
            DataContext="{Binding AdminViewModel}"
            ColumnDefinitions="220, *">

            <!-- === ЛЕВАЯ ЧАСТЬ: Боковая панель ==== -->
            <ContentControl
                Classes="CyberpunkInnerContainer"
                Grid.Column="0" Margin="5,0,5,0">
                <Grid RowDefinitions="Auto, *">
                    
                    <!-- 🔝 ШАПКА ПАНЕЛИ: Упакованный бургер-контрол и заголовок -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto, *">
                        <controls:AccountMenuControl Grid.Column="0"/>
                        <TextBlock
                            Grid.Column="1" 
                            Text="АДМИН ПАНЕЛЬ" 
                            FontWeight="Bold"
                            Foreground="#FFF5546F" 
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            FontSize="13"/>
                    </Grid>

                    <!-- НАВИГАЦИОННЫЕ КНОПКИ УПРАВЛЕНИЯ -->
                    <Grid Grid.Row="1"
                          RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                          VerticalAlignment="Top" Margin="0,10,0,0">

                        <Button
                            Grid.Row="0"
                            Content="{Binding TableButtonText,
                            FallbackValue='Показать users'}" 
                            Command="{Binding ShowUserTableCommand}"
                            Classes="cyber-btn"
                            HorizontalAlignment="Stretch"
                            Margin="0,3"/>
                        
                        <Button
                            Grid.Row="1"
                            Content="{Binding ToggleButtonText,
                            FallbackValue='Показать log'}" 
                            Command="{Binding ShowLogPanelCommand}" 
                            Classes="cyber-btn"
                            HorizontalAlignment="Stretch"
                            Margin="0,3"/>
                        
                        <Button
                            Grid.Row="2"
                            Content="{Binding DeleteButtonText,
                            FallbackValue='Удалить юзера'}"
                            Command="{Binding ShowDeleteFormCommand}"
                            Classes="cyber-btn"
                            HorizontalAlignment="Stretch"
                            Margin="0,3"/>
                        
                        <Button
                            Grid.Row="3"
                            Content="{Binding SeedButtonText,
                            FallbackValue='Сидинг Users'}" 
                            Command="{Binding ShowSeedFormCommand}" 
                            Classes="cyber-btn"
                            HorizontalAlignment="Stretch"
                            Margin="0,3"/>
                        
                        <Button
                            Grid.Row="4"
                            Content="{Binding InspectorButtonText,
                            FallbackValue='Инспектор шины'}" 
                            Command="{Binding ShowInspectorCommand}" 
                            Classes="cyber-btn"
                            HorizontalAlignment="Stretch"
                            Margin="0,3"/>
                    </Grid>
                </Grid>
            </ContentControl>

            <!-- === ПРАВАЯ ЧАСТЬ: Рабочая зона вкладок === -->
            <Grid Grid.Column="1">
                <Grid.Styles>
                    <!-- Базово прячем все контейнеры-вкладки -->
                    <Style Selector="ContentControl.tab-content">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                </Grid.Styles>

                <!-- Блок А: Таблица пользователей -->
                <ContentControl
                    Classes="tab-content" 
                    IsVisible="{Binding ActiveTab,
                    Converter={StaticResource EqualityConverter},
                    ConverterParameter={x:Static enums:AdminSubTab.UserTable}}">
                    <controls:UsersTableControl/>
                </ContentControl>

                <!-- Блок Б: Панель Логов -->
                <ContentControl
                    Classes="tab-content" 
                    IsVisible="{Binding ActiveTab,
                    Converter={StaticResource EqualityConverter},
                    ConverterParameter={x:Static enums:AdminSubTab.Logger}}">
                    <controls:LogRenderControl
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                </ContentControl>

                <!-- Блок В: Удаление пользователей (Исправлено навешиванием tab-content) -->
                <ContentControl
                    Classes="tab-content" 
                    IsVisible="{Binding ActiveTab,
                    Converter={StaticResource EqualityConverter},
                    ConverterParameter={x:Static enums:AdminSubTab.DeleteUsers}}">
                    <controls:DeleteUsersControl/>
                </ContentControl>

                <!-- Блок Г: Инспектор шины событий (Исправлено навешиванием tab-content) -->
                <ContentControl
                    Classes="tab-content" 
                    IsVisible="{Binding ActiveTab,
                    Converter={StaticResource EqualityConverter},
                    ConverterParameter={x:Static enums:AdminSubTab.EventInspector}}">
                    <controls:InspectorViewControl/>
                </ContentControl>

                <!-- Блок Д: Модуль сидинга (Исправлено навешиванием tab-content) -->
                <ContentControl
                    Classes="tab-content" 
                    IsVisible="{Binding ActiveTab,
                    Converter={StaticResource EqualityConverter},
                    ConverterParameter={x:Static enums:AdminSubTab.SeedUsers}}">
                    <controls:SeedUsersViewControl/>
                </ContentControl>

            </Grid>
        </Grid>
    </ContentControl>
</UserControl>
