<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:HomeNetPresentation.ViewModels.AdminViews"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="750"
             x:Class="HomeNetAvalonia.Controls.InspectorViewControl">

    <!-- 📡 Подвязываем DataContext к твоей чистой InspectorViewModel из Хаба ресурсов -->
  <Grid DataContext="{DynamicResource ComponentHub}" x:CompileBindings="False">
    <Grid DataContext="{Binding InspectorViewModel}">

        <!-- 🟢 Твой любимый строгий радиус скругления 3 -->
        <Border BorderBrush="#304050"
                BorderThickness="0.4" CornerRadius="3" Padding="15" Background="#FF111318">
            
            <!-- 🔥 Оборачиваем всё в Grid, чтобы наложить слои -->
            <Grid>
                <!-- 🔥 1. Слой загрузки (показывается, если IsScanning = true) -->
                <TextBlock 
                    Text="⌛ Идёт сканирование сборок... Пожалуйста, подождите." 
                    Foreground="#00F0FF" 
                    FontFamily="Consolas"
                    FontSize="14"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsScanning}"/>

                <!-- 🔥 2. Слой с графом (показывается, если IsScanning = false) -->
                <ScrollViewer 
                    HorizontalScrollBarVisibility="Disabled" 
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding !IsScanning}">

                    <ItemsControl ItemsSource="{Binding GraphLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding Text}" 
                                    Tag="{Binding State, StringFormat='{}{0}'}"
                                    FontFamily="Consolas" 
                                    FontSize="12" 
                                    FontWeight="Bold"
                                    LetterSpacing="-0.5"
                                    Margin="0,1">
                                    
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="Foreground" Value="#00F0FF"/>
                                        </Style>
                                        <Style Selector="TextBlock[Tag=Published]">
                                            <Setter Property="Foreground" Value="Red"/>
                                        </Style>
                                        <Style Selector="TextBlock[Tag=Subscribed]">
                                            <Setter Property="Foreground" Value="#FFB300"/>
                                        </Style>
                                        <Style Selector="TextBlock[Tag=Live]">
                                            <Setter Property="Foreground" Value="#00FF66"/>
                                        </Style>
                                    </TextBlock.Styles>
                                    
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>
            </Grid>
            
        </Border>
    </Grid>
</Grid>
</UserControl>
