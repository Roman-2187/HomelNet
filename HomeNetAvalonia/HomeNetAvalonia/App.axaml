<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:siber="using:HomeNetPresentation.ViewModels;assembly=HomeNetPresentation"
    xmlns:val="using:HomeNetCore.Models.Validation;assembly=HomeNetCore"   
    xmlns:enums="using:HomeNetCore.Enums.Navigation;assembly=HomeNetCore"
    xmlns:di="clr-namespace:HomeNet.DI;assembly=HomeNet.DI"
    xmlns:conv="using:HomeNetAvalonia.Converters"
    x:Class="HomeNetAvalonia.App"
    
    RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Твой хаб-локатор встает без ошибок -->
        <di:ComponentHub x:Key="ComponentHub"/>
         <Bitmap x:Key="CyberBackground">avares://HomeNetAvalonia/Assets/68fadad90ca053b59b3e0178c4983607.png</Bitmap>
        <Bitmap x:Key="BlackCatAvatar">avares://HomeNetAvalonia/Assets/blackcat.jpg</Bitmap>
        
    </Application.Resources>
    
   <Application.Styles>
    <!-- Твоя FluentTheme здесь уже стоит -->
    <FluentTheme />



       <StyleInclude Source="avares://HomeNetAvalonia/Themes/SystemButtons.axaml"/>
    <StyleInclude Source="avares://HomeNetAvalonia/Themes/ActionButtons.axaml"/>
        <StyleInclude Source="avares://HomeNetAvalonia/Themes/Fields.axaml"/>
       <StyleInclude Source="avares://HomeNetAvalonia/Themes/Containers.axaml"/>

       <!-- Стили для анимации сворачивания Зайбернета -->


    
   
</Application.Styles>

</Application
>
