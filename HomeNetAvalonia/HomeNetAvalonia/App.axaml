<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            
             xmlns:di="clr-namespace:HomeNet.DI;assembly=HomeNet.DI"
             x:Class="HomeNetAvalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Твой хаб-локатор встает без ошибок -->
        <di:ComponentHub x:Key="ComponentHub"/>
    </Application.Resources>
    
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
