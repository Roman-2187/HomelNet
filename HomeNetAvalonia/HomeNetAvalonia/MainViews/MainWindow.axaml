<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HomeNetAvalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:HomeNetAvalonia.Views"
        xmlns:conv="using:HomeNetAvalonia.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="HomeNetAvalonia.Views.MainWindow"
        MinWidth="400" MinHeight="300" 
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="{x:Null}"
        WindowStartupLocation="CenterScreen"
        
        Width="{Binding $parent[Window].Screens.Primary.Bounds.Width, Converter={StaticResource ScreenPercentConverter}, ConverterParameter=80}"
        Height="{Binding $parent[Window].Screens.Primary.Bounds.Height, Converter={StaticResource ScreenPercentConverter}, ConverterParameter=80}">

    <Window.Resources>
        <!-- Регистрируем конвертер локально -->
        <conv:ScreenPercentConverter x:Key="ScreenPercentConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition 
                        Property="RenderTransform" 
                        Duration="0:0:0.5" 
                        Easing="QuadraticEaseIn"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Window.exit-anim">
            <Setter Property="RenderTransform" Value="translateY(1200px)"/>
        </Style>
    </Window.Styles>

    <!-- Единый контейнер, который заполняет всё окно -->
    <Border Background="Transparent" 
           
            
            
            BoxShadow="0 0 20 0 #55000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        
        <views:MainView />
        
    </Border>
</Window>