<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
	<PropertyGroup>
		<RootNamespace>HomeNetAvalonia</RootNamespace>
		<TargetFramework>net10.0-browser</TargetFramework>
		<OutputType>Exe</OutputType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>

		<!-- 🔥 ОТКЛЮЧАЕМ ЦЕНТРАЛЬНЫЙ МЕНЕДЖЕР ПАКЕТОВ ДЛЯ ВЕБА: -->
		<!-- Это позволит нам вручную задавать версии NuGet прямо здесь! -->
		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

		<WasmBuildNative>true</WasmBuildNative>
		<RunAOTCompilation>false</RunAOTCompilation>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Browser" Version="11.1.3" />

		<!-- 🔥 И теперь спокойно возвращаем точную версию нативной графики веба! -->
		<PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="2.88.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\HomeNetAvalonia\HomeNetAvalonia.csproj" />
	</ItemGroup>

	<ItemGroup>
		
		<PackageReference Include="Avalonia.HarfBuzz" Version="11.1.3" />
	</ItemGroup>

	<ProjectExtensions>
		<VisualStudio>
			<UserProperties properties_4launchsettings_1json__JsonSchema="https://schemastore.org" />
		</VisualStudio>
	</ProjectExtensions>
</Project>
