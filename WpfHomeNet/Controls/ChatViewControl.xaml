<UserControl x:Class="WpfHomeNet.Controls.ChatViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfHomeNet.Controls"
             mc:Ignorable="d"  Background="Transparent"
             d:DesignHeight="600" d:DesignWidth="500">

    <ContentControl Style="{StaticResource CyberpunkImageStyle}" Margin="5,0,0,0" >
        <ContentControl.Tag>
            <CornerRadius>6</CornerRadius>
        </ContentControl.Tag>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <!-- 0: Верхняя плашка -->
                <RowDefinition Height="*"/>
                <!-- 1: Лента эсэмэсок -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Нижняя панель ввода -->
            </Grid.RowDefinitions>

            <!-- ==================== ROW 0: ВЕРХНЯЯ ПЛАШКА ==================== -->
            <Border Grid.Row="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,1">
                <Grid Margin="15,0">
                    <StackPanel VerticalAlignment="Center">
                        <!-- 🔥 ДИНАМИКА: Имя собеседника из выбранного друга -->
                        <TextBlock Text="{Binding SelectedFriend.FirstName, FallbackValue='Выберите собеседника'}" 
                                   FontWeight="Bold" FontSize="16" Foreground="#FFB300"/>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" >
                            <Ellipse Width="8" Height="8" Fill="#4CAF50"
                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="в сети" FontSize="12" Foreground="#757575"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ROW 1: ЛЕНТА СООБЩЕНИЙ ==================== -->
            <!-- Выводим сообщения через ListBox, привязанный к коллекции Messages -->
            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding Messages}" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Временный простой вывод текста сообщения. Позже натянем красивые пузыри! -->
                        <Border Background="#1AADD8E6" BorderBrush="#00F0FF"
                                BorderThickness="0.5"
                                CornerRadius="25" Margin="2" Padding="25,5,25,5">
                            <TextBlock Text="{Binding Text}" Foreground="#FFB300" 
                                       TextWrapping="Wrap" FontSize="18"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ==================== ROW 2: НИЖНЯЯ ПАНЕЛЬ ВВОДА ==================== -->
            <Border Grid.Row="2" CornerRadius="8" Background="Transparent" BorderBrush="#00F0FF"
                    Margin="5" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Скрепка -->
                        <ColumnDefinition Width="*"/>
                        <!-- Поле ввода -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Отправить -->
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка "Скрепка" -->
                    <Button Grid.Column="0" Command="{Binding AttachFileCommand}"
                            Background="#1AADD8E6" Foreground="White" Content="📎" 
                            FontSize="20"  BorderThickness="0.5" BorderBrush="#00F0FF" Width="40" Height="40" Cursor="Hand"/>

                    <!-- 🔥 ДИНАМИКА: Текстовое поле с мгновенным обновлением свойства MessageText -->
                    <TextBox Grid.Column="1" 
                             Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" VerticalContentAlignment="Center" BorderThickness="0.5" Foreground="#FFB300"
                             Padding="10,0" Margin="10,0" BorderBrush="#00F0FF" Background="#1AADD8E6"  />

                    <!-- 🔥 ДИНАМИКА: Кнопка "Отправить" привязана к команде SendMessageCommand -->
                    <Button Grid.Column="2" Command="{Binding SendMessageCommand}" 
                            Content="🚀" FontSize="18" Background="#1AADD8E6" 
                            Foreground="White" BorderThickness="0.5" Width="50" BorderBrush="#00F0FF" Height="40" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </ContentControl>

</UserControl>
