<UserControl x:Class="WpfHomeNet.Controls.ChatViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfHomeNet.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- 0: Верхняя плашка (Имя + Статус) -->
            <RowDefinition Height="*"/>
            <!-- 1: Лента эсэмэсок (Скролл) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Нижняя панель (Ввод + Скрепка) -->
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: ВЕРХНЯЯ ПЛАШКА ==================== -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <StackPanel VerticalAlignment="Center">
                    <!-- Имя собеседника (брата) -->
                    <TextBlock Text="Брат " 
                               FontWeight="Bold" FontSize="16"
                               Foreground="#212121"/>
                    <!-- Живой статус, под который мы потом прикрутим PostgreSQL -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,2,0,0">
                        <Ellipse Width="8" Height="8"
                                 Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="в сети"
                                   FontSize="12" Foreground="#757575"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 1: ЛЕНТА СООБЩЕНИЙ ==================== -->
        <!-- Сюда мы позже прикрутим ListView с твоим любимым индексёром валидации и шаблонами сообщений -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
            <StackPanel>
                <!-- Заглушка, чтобы увидеть, как будут выглядеть сообщения -->
                <Border Background="#E3F2FD" CornerRadius="10" Padding="10"
                        HorizontalAlignment="Left" Margin="0,5" MaxWidth="350">
                    <TextBlock Text="Привет! Как там твой суверенный мессенджер поживает? 
                               Сумел логгер настроить?" TextWrapping="Wrap"/>
                </Border>
                <Border Background="#DCF8C6" CornerRadius="10"
                        Padding="10" HorizontalAlignment="Right" Margin="0,5" MaxWidth="350">
                    <TextBlock
                        Text="Привет! Да, сука, всё настроил, счётчик теперь работает как атомные часыгонку потоков разгромил!"
                        TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

      
        <!-- ==================== ROW 2: НИЖНЯЯ ПАНЕЛЬ ВВОДА ==================== -->
        <!-- ==================== ROW 2: НИЖНЯЯ ПАНЕЛЬ ВВОДА ==================== -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 0: Кнопка Скрепка -->
                    <ColumnDefinition Width="*"/>
                    <!-- 1: Поле ввода текста -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 2: Кнопка Отправить -->
                </Grid.ColumnDefinitions>

                <!-- Кнопка "Скрепка" для будущей отправки файлов брату -->
                <Button Grid.Column="0" Content="📎" FontSize="20" Background="Transparent" BorderThickness="0" Width="40" Height="40" Cursor="Hand"/>

                <!-- Текстовое поле для набора эсэмэски -->
                <TextBox Grid.Column="1" Height="40" VerticalContentAlignment="Center" Padding="10,0" Margin="10,0" BorderBrush="#E0E0E0"/>

                <!-- Кнопка "Отправить" -->
                <Button Grid.Column="2" Content="🚀" FontSize="18" Background="#2196F3" Foreground="White" BorderThickness="0" Width="50" Height="40"/>
            </Grid>
        </Border>


    </Grid>
</UserControl>
