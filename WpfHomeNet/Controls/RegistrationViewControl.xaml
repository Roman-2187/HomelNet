<UserControl x:Class="WpfHomeNet.Controls.RegistrationViewControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:viewmodels="clr-namespace:WpfHomeNet.ViewModels"             
 xmlns:converter="clr-namespace:WpfHomeNet.Converters"
 Visibility="{Binding ControlVisibility,
    RelativeSource={RelativeSource AncestorType=UserControl}}"
 x:Name="RegistrationControl"
 mc:Ignorable="d" 
 Background="Transparent"
 BorderThickness="0"   
 Height="Auto" 
 Width="600"
 
             Style="{StaticResource UniversalFlyOutTopStyle}" d:Opacity="1" >





    <UserControl.Resources>
        <converter:StateToBrushConverter x:Key="StateToBrushConverter"/>
        <converter:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <ContentControl Style="{StaticResource CyberpunkImageStyle }" Padding="0" >
        <ContentControl.Tag>
            <CornerRadius>6</CornerRadius>
        </ContentControl.Tag>
        <Grid Margin="15" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110*"/>
                <ColumnDefinition Width="37*"/>
            </Grid.ColumnDefinitions>

            <!-- USER NAME -->
            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,5" Grid.ColumnSpan="2">
                <Label Content="Имя пользователя:" VerticalAlignment="Center" Foreground="#00F0FF"/>
                <TextBox
                Style="{StaticResource NeonTextBoxStyle}"
                Text="{Binding UserData.FirstName}"
                BorderBrush="{Binding ValidationResults[NameType].State, Converter={StaticResource StateToBrushConverter}}"
                IsEnabled="{Binding IsComplete, Converter={StaticResource InverseBooleanConverter}}"/>

                <Label Content="{Binding ValidationResults[NameType].Message}"
                Foreground="{Binding ValidationResults[NameType].State, Converter={StaticResource StateToBrushConverter}}"
                FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- EMAIL -->
            <StackPanel Orientation="Vertical" Margin="0,89,0,5" Grid.ColumnSpan="2" Grid.RowSpan="2">
                <Label Content="Email:" VerticalAlignment="Center" Foreground="#00F0FF"  />
                <TextBox 
                Style="{StaticResource NeonTextBoxStyle}"
                Text="{Binding UserData.Email}"
                BorderBrush="{Binding ValidationResults[EmailType].State, Converter={StaticResource StateToBrushConverter}}"
                IsEnabled="{Binding IsComplete, Converter={StaticResource InverseBooleanConverter}}"/>

                <Label Content="{Binding ValidationResults[EmailType].Message}"  
                Foreground="{Binding ValidationResults[EmailType].State, Converter={StaticResource StateToBrushConverter}}"
                FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- PASSWORD -->
            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,5" Grid.ColumnSpan="2">
                <Label Content="Пароль:" VerticalAlignment="Center" Foreground="#00F0FF"/>
                <TextBox
                Style="{StaticResource NeonTextBoxStyle}"
                Text="{Binding UserData.Password}"
                BorderBrush="{Binding ValidationResults[PasswordType].State, Converter={StaticResource StateToBrushConverter}}"
                IsEnabled="{Binding IsComplete, Converter={StaticResource InverseBooleanConverter}}"/>

                <Label Content="{Binding ValidationResults[PasswordType].Message}"
                Foreground="{Binding ValidationResults[PasswordType].State, Converter={StaticResource StateToBrushConverter}}"
                FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- CONFIRMED PASSWORD -->
            <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,5" Grid.ColumnSpan="2">
                <Label Content="Повторите пароль:" VerticalAlignment="Center" Foreground="#00F0FF"/>
                <TextBox 
                Style="{StaticResource NeonTextBoxStyle}"
                Text="{Binding UserData.ConfirmPassword}"
                BorderBrush="{Binding ValidationResults[ConfirmedPasswordType].State, Converter={StaticResource StateToBrushConverter}}"
                IsEnabled="{Binding IsComplete, Converter={StaticResource InverseBooleanConverter}}"/>

                <Label Content="{Binding ValidationResults[ConfirmedPasswordType].Message}"
                Foreground="{Binding ValidationResults[ConfirmedPasswordType].State, Converter={StaticResource StateToBrushConverter}}"
                FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ -->
            <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,89,0,0" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="{Binding StatusMessage}" MinWidth="50" Foreground="#00F0FF" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>

                <!-- BUTTONS -->
                <StackPanel Grid.Column="1" Margin="0,0,0,0" Height="45" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" 
                            Style="{StaticResource NeonRegistrationButtonStyle}"
                            Command="{Binding CancelCommand}" 
                            IsEnabled="{Binding IsComplete, Converter={StaticResource InverseBooleanConverter}}" 
                            Width="120"/>

                    <Button Content="{Binding SubmitButtonText}" 
                            Style="{StaticResource NeonRegistrationButtonStyle}"
                            Command="{Binding ToggleRegistrationCommand}"  
                            IsEnabled="{Binding IsComplete, Converter={StaticResource InverseBooleanConverter}}"
                            Width="120"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ContentControl>

</UserControl>

