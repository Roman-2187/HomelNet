<UserControl x:Class="WpfHomeNet.Controls.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfHomeNet.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">

    <!-- Твоя фирменная подложка и цвета -->
    <Border BorderBrush="#FFF23E5C"  BorderThickness="1"
        Padding="4" CornerRadius="8" 
                    Background="Transparent">
        <StatusBar Background="#00A3C091">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText, FallbackValue='Загрузка системы...'}"
                           Margin="2"
                           FontWeight="Bold"
                           Foreground="#FFB300"/>
            </StatusBarItem>
        </StatusBar>
       </Border>

</UserControl>
