<UserControl x:Class="WpfHomeNet.Controls.UserDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfHomeNet.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Левая колонка: Друзья -->
            <ColumnDefinition Width="*"/>
            <!-- Правая колонка: Будущий Чат -->
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: СПИСОК ДРУЗЕЙ -->

        <ContentControl Style="{StaticResource CyberpunkStyle}" Padding="4" >
            <ContentControl.Tag>
                <CornerRadius>10</CornerRadius>
                <!-- Внутренняя матрешка тоже хочет знать радиус! -->
            </ContentControl.Tag>
            </ContentControl>

            <local:ChatViewControl  Grid.Column="1">
                
            </local:ChatViewControl>
       
            
            
    </Grid>
</UserControl>
