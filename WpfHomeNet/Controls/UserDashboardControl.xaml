<UserControl x:Class="WpfHomeNet.Controls.UserDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfHomeNet.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Левая колонка: Друзья -->
            <ColumnDefinition Width="*"/>
            <!-- Правая колонка: Будущий Чат -->
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: СПИСОК ДРУЗЕЙ -->
        <ContentControl Style="{StaticResource TripleBorderDeepBlueStyle}" Grid.Column="0"  >

            <ContentControl.Tag>
                <CornerRadius>8</CornerRadius>

            </ContentControl.Tag>
            <Grid Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="👥 Контакты сети" Foreground="Black" FontWeight="Bold" FontSize="14" Margin="5,0,0,10"/>

                <!-- Биндим список напрямую к коллекции Friends из нашей UserDashboardViewModel -->
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Friends}" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Foreground="Black" FontWeight="Bold"
                         FontSize="13" d:ItemsSource="{d:SampleData ItemCount=5}"/>
            </Grid>
            </ContentControl>

        <!-- ПРАВАЯ ПАНЕЛЬ: РАБОЧАЯ ЗОНА ДЛЯ ЧАТА -->
        <ContentControl Style="{StaticResource TripleBorderBlueStyle}" Grid.Column="1" Margin="5,0,0,0" >
           
                <ContentControl.Tag>
                    <CornerRadius>8</CornerRadius>
                  
                </ContentControl.Tag>
                <Grid Margin="5">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="Добро пожаловать в HomeNet, " FontSize="18" Foreground="Black"/>
                        <!-- Мягко вытягиваем имя из CurrentUser. Если имени нет (тест) — покажет 'Пользователь' -->
                        <TextBlock Text="{Binding CurrentUser.FirstName, FallbackValue='Пользователь'}" FontSize="18" FontWeight="Bold" Foreground="#4FC1FF"/>
                    </StackPanel>

                    <TextBlock Text="Выберите собеседника на левой панели, чтобы начать шифрованный диалог." 
                               Foreground="#8E8E93" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="13"/>
                </StackPanel>
            </Grid>
            </ContentControl>
    </Grid>
</UserControl>
