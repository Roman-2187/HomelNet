<UserControl
    x:Class="WpfHomeNet.Controls.AdminMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
    xmlns:converter="clr-namespace:WpfHomeNet.Converters"
    xmlns:controls="clr-namespace:WpfHomeNet.Controls"
    Background="Transparent" 
    mc:Ignorable="d" 
    d:DesignHeight="500" d:DesignWidth="740">
             
        <UserControl.Resources>
            <BooleanToVisibilityConverter
                x:Key="BooleanToVisibilityConverter"/>
            <converter:InverseBooleanToVisibilityConverter 
                x:Key="InverseBooleanVisibleConverter"/>
            <converter:InverseBooleanConverter
                x:Key="InverseBooleanConverter"/>
        </UserControl.Resources>

    <ContentControl 
            Style="{StaticResource InnerBorderSolidColorStyle}"
            Background="#FFA4B291">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <!-- Левая боковая панель кнопок -->
                <ColumnDefinition Width="*"/>
                <!-- Вся правая область под контент -->
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ЧАСТЬ: Боковая панель кнопок управления -->
            <StackPanel
                    Grid.Column="0"  Margin="5"
                    IsEnabled="{Binding MainVm.IsButtonsPanelEnabled,
                    Source={StaticResource VmLocator}}">

                <Label
                        Content="АДМИН ПАНЕЛЬ" FontWeight="Bold"
                        HorizontalAlignment="Center" Margin="0,5,0,15"
                        Foreground="#333"/>

                <!-- Кнопки профиля и регистрации теперь бьют СТРОГО через VmLocator!-->

                <Button Content="User Profile" Margin="0,3"  
                        Command="{Binding MainVm.ToggleFormVisibilityCommand,
                        Source={StaticResource VmLocator}}"
                        CommandParameter="{Binding LoginVm,
                        Source={StaticResource VmLocator}}" />

                <Button
                        Content="Test list Users"
                        Margin="0,3" 
                        Command="{Binding SeedDataCommand}"/>

                <Button 
                        Content="Добавить юзера" Margin="0,3"                    
                        Command="{Binding MainVm.ToggleFormVisibilityCommand,
                        Source={StaticResource VmLocator}}"
                        CommandParameter="{Binding RegistrationVm,
                        Source={StaticResource VmLocator}}"
                        IsEnabled="{Binding MainVm.IsComplete,
                        Source={StaticResource VmLocator},
                        Converter={StaticResource InverseBooleanConverter}}"/>

                <!-- Кнопка вызова формы удаления юзеров -->
                <Button 
                        Content="Удалить юзера" Margin="0,3"
                        Command="{Binding MainVm.ToggleFormVisibilityCommand,
                        Source={StaticResource VmLocator}}" 
                        CommandParameter="{Binding DeleteUsersVm,
                        Source={StaticResource VmLocator}}" />

                <!-- ВОЗВРАЩАЕМ НАШУ НАНО-КНОПКУ ТАБЛИЦЫ С БОЛЬШОЙ БУКВЫ! 👁️✨ -->
                <Button 
                        Margin="0,3"
                        Content="{Binding TableButtonText}"                    
                        Command="{Binding UserTableViewCommand}"/>

                <Button
                        Margin="0,3"
                        Command="{Binding ToggleLogWindowCommand}"     
                        Content="{Binding ToggleButtonText}"/>
            </StackPanel>

            <!-- ПРАВАЯ ЧАСТЬ: Динамическая рабочая зона  -->
            <Grid 
                    Grid.Column="1" Margin="5">

                <!-- 1. ТАБЛИЦА ПОЛЬЗОВАТЕЛЕЙ -->
                <Border 
                        Background="White" CornerRadius="4" 
                        BorderThickness="1" BorderBrush="#DDD"
                        Visibility="{Binding IsTableVisible,
                        Converter={StaticResource BooleanToVisibilityConverter}}"
                        d:Visibility="Visible">
                    <!-- Таблица сама берет свои мозги из глобального Локатора ресурсов -->
                    <!-- БЫЛО: Source={StaticResource Locator} -->
                    <!-- СТАЛО (Подключаемся к твоему реальному локатору): 🧼 -->
                    <!-- БЫЛО: DataContext="{Binding Users, Source={StaticResource VmLocator}}" -->
                    <!-- СТАЛО (Вытаскиваем из локатора именно ВьюМодель таблицы): 🧼 -->
                    <controls:UsersTableView DataContext="{Binding UsersTable, Source={StaticResource VmLocator}}" />



                </Border>

                <!-- 2. ФОРМА УДАЛЕНИЯ ЮЗЕРОВ 🦾🔥 -->
                <Border 
                        Background="#FFF0F0"
                        CornerRadius="4" 
                        BorderThickness="1"                         BorderBrush="#FFAAAA"
                        Visibility="{Binding DeleteUsersVm.ControlVisibility, 
                        Source={StaticResource VmLocator}}">

                    <controls:DeleteUsers
                            DataContext="{Binding DeleteUsersVm,
                            Source={StaticResource VmLocator}}"
                            Margin="10"/>
                </Border>
            </Grid>
        </Grid>
    </ContentControl>
</UserControl>  
