<UserControl x:Class="WpfHomeNet.Controls.LogRenderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfHomeNet.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <RichTextBox x:Name="LogTextBox" 
                                    
                     VerticalScrollBarVisibility="Hidden"
                     IsReadOnly="True" 
                     FontSize="14" 
                     FontWeight="Bold"
                     Foreground="White" 
                     SelectionBrush="#FF297AB8">
            <RichTextBox.Style>
                <Style TargetType="RichTextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <!-- Кастомный контейнер с круглыми углами, как в оригинале -->
                            <ControlTemplate TargetType="RichTextBox">
                                <Border x:Name="bg" 
                                        CornerRadius="6" 
                                        Background="#FF464545" 
                                        BorderBrush="#FFF23E5C" 
                                        BorderThickness="1">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="5"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </RichTextBox.Style>
        </RichTextBox>
    </Grid>
</UserControl>
