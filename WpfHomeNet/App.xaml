 <Application x:Class="HomeSocialNetwork.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfHomeNet" 
             xmlns:vm="clr-namespace:WpfHomeNet.ViewModels"   
             xmlns:cv="clr-namespace:WpfHomeNet.Converters" >
    

    <Application.Resources>
       
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:ViewModelLocator x:Key="VmLocator" />
        <cv:CornerRadiusConverter x:Key="RadiusCalc" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <!-- 🍊 СТАТИКА: Оранжево-золотые буквы по умолчанию -->
            <Setter Property="Foreground" Value="#FFB300"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                         Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="{TemplateBinding BorderThickness}"
                         CornerRadius="6"
                         Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextElement.FontWeight="{TemplateBinding FontWeight}"
                                       TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- 🚨 НАВЕДЕНИЕ КУРСОРA: Красный фон + Неоновый текст -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Заполнение кнопки плотным красным цветом (из палитры Киберпанка) -->
                                <Setter TargetName="border" Property="Background" Value="#FFF23E5C"/>
                                <!-- Текст горит неоновым голубым/бирюзовым -->
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#00F0FF"/>
                                <!-- Тонкая неоновая рамка вокруг красной заливки -->
                                <Setter TargetName="border" Property="BorderBrush" Value="#00F0FF"/>
                            </Trigger>

                            <!-- 🌌 НАЖАТИЕ: Уход в глубокий темный -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF131926"/>
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="White"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF0D111A"/>
                            </Trigger>

                            <!-- 🚫 ОТКЛЮЧЕННОЕ СОСТОЯНИЕ -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#FF615959"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- 🔽 ИСПРАВЛЕННЫЙ СТИЛЬ 1: Форма входа/регистрации (Полный цикл полётов) -->
        <Style x:Key="CyberpunkFlyOutTopStyle" TargetType="UserControl">
            <Setter Property="Visibility" Value="{Binding ControlVisibility}"/>

            <!-- Изначально вывешиваем форму в космос на -600 -->
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="-600"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Opacity" Value="0"/>

            <Style.Triggers>
                <!-- 🎯 ТРИГГЕР 1: Плавный спуск сверху вниз, когда форма становится видимой -->
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                         From="-600" To="0" 
                                         Duration="0:0:0.5"
                                         AccelerationRatio="0.2" 
                                         DecelerationRatio="0.8"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" 
                                         Duration="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>

                <!-- 🎯 ТРИГГЕР 2: Выталкивание наверх в космос при УСПЕХЕ (IsComplete == True) -->
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                         To="-600" 
                                         Duration="0:0:0.5"
                                         AccelerationRatio="0.3" 
                                         DecelerationRatio="0.7"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="0" 
                                         Duration="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>

                <!-- 🎯 ТРИГГЕР 3: 🔥 НАШ НОВЫЙ ПОРШЕНЬ: Выталкивание наверх при ОТМЕНЕ (IsCancelled == True) -->
                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Точно так же уносим с отметки 0 наверх на -600 -->
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                         To="-600" 
                                         Duration="0:0:0.5"
                                         AccelerationRatio="0.3" 
                                         DecelerationRatio="0.7"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="0" 
                                         Duration="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>






        <!-- 🔼 ОКОНЧАТЕЛЬНЫЙ СТИЛЬ 2: Профиль пользователя (В дизайнере на месте, а в рантайме взлетает СТРОГО ПРИ УСПЕХЕ) -->
        <Style x:Key="CyberpunkFlyInBottomStyle" TargetType="UserControl">

            <!-- 🛠️ ЖЕСТКАЯ БАЗА: При старте приложения профиль ВСЕГДА мёртво сидит в подвале на +800 и скрыт -->
            <!-- 🔥 ХАК ДЛЯ ДИЗАЙНЕРА: Через FallbackValue мы заставляем Студию думать, что по умолчанию Y=0 и Opacity=1, чтобы ты видел чат на превью! -->
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="{Binding DummyProperty, FallbackValue=800, TargetNullValue=800}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Opacity" Value="0"/>

            <Style.Triggers>
                <!-- 🚀 МОМЕНТ ВХОДА: Врубается ТОЛЬКО тогда, когда MainInterfaceVisibility реально становится Visible! -->
                <DataTrigger Binding="{Binding DataContext.MainInterfaceVisibility, RelativeSource={RelativeSource AncestorType=Window}}" Value="Visible">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Плавно толкаем поршень снизу (+800) вверх в рабочую точку (0) за 550 мс -->
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                         From="800" To="0" 
                                         Duration="0:0:0.55"
                                         AccelerationRatio="0.2" 
                                         DecelerationRatio="0.8"/>

                                <!-- Плавно зажигаем неоновое проявление из прозрачности -->
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" 
                                         Duration="0:0:0.45"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>



        <Style x:Key="BorderedContentStyle" TargetType="ContentControl">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border 
                    BorderThickness="0.15"
                    Margin="1,1,1,0"
                    BorderBrush="Black"
                    Padding="4"
                    CornerRadius="8" 
                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                            <TextBlock
                        Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        FontSize="12"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🧊 КУБИК 1: Синяя сталь на ContentControl через честный Tag! 🎛️ -->
        <Style x:Key="TripleBorderBlueStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 👑 ВНЕШНИЙ БОРДЕР: Тянет CornerRadius напрямую из кармашка Tag! -->
                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                    BorderThickness="0.65" BorderBrush="Black" Background="White">
                                <Grid>

                                    <!-- 🥈 СРЕДНИЙ БОРДЕР: Берет радиус из Tag и вычитает 0.6 через калькулятор -->
                                    <Border BorderThickness="1.1" Margin="-0.15" BorderBrush="LightBlue" 
                                            CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                        Converter={StaticResource RadiusCalc}, ConverterParameter=-0.6}"/>

                                    <!-- 🥉 ВНУТРЕННИЙ БОРДЕР: Берет радиус из Tag и вычитает 0.65 -->
                                    <Border Margin="0.35" BorderThickness="0.6" BorderBrush="Black"
                                            CornerRadius="{Binding Tag,
                                        RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RadiusCalc}, ConverterParameter=-0.65}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <!-- 🌌 Верх: Твой стальной сине-зелёный -->
                                                <GradientStop Color="#FF71B5B3" Offset="0.0"/>

                                                <!-- 🧊 НАЧАЛО РАЗМЫТИЯ: Свет блика начинает плавно входить уже с 40% высоты -->
                                                <GradientStop Color="#FF9ABCBC" Offset="0.4"/>

                                                <!-- 🧊 КОНЕЦ РАЗМЫТИЯ: Свет блика мягко удерживается до 75% высоты -->
                                                <GradientStop Color="#FF9ABCBC" Offset="0.75"/>

                                                <!-- 💎 Низ: Твой стальной сине-зелёный -->
                                                <GradientStop Color="#FF71B5B3" Offset="1.0"/>
                                            </LinearGradientBrush>

                                           
                                        </Border.Background>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🧊 КУБИК 1: Истинный DarkBlue (Мягкое затемнение на 10% от исходного сине-зелёного) 🎛️ -->
        <Style x:Key="TripleBorderDarkBlueStyle" TargetType="ContentControl">
            <!-- 🎯 ЗАДАЕМ РАДИУС ПО УМОЛЧАНИЮ (Пользователь может переопределить его в своем элементе) -->
            <Setter Property="Tag" Value="8"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 👑 ВНЕШНИЙ БОРДЕР -->
                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                            BorderThickness="0.65" BorderBrush="DarkRed" Background="White">
                                <Grid>
                                    <!-- 🥈 СРЕДНИЙ БОРДЕР -->
                                    <Border BorderThickness="1.1" Margin="-0.15" BorderBrush="#FF4B7E7C" 
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                    Converter={StaticResource RadiusCalc}, ConverterParameter=-0.6}"/>

                                    <!-- 🥉 ВНУТРЕННИЙ БОРДЕР -->
                                    <Border Margin="0.35" BorderThickness="0.6" BorderBrush="Black"
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, 
                                    Converter={StaticResource RadiusCalc}, ConverterParameter=-0.65}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#FF65A2A0" Offset="0.0"/>
                                                <GradientStop Color="#FF8AA9A9" Offset="0.4"/>
                                                <GradientStop Color="#FF8AA9A9" Offset="0.75"/>
                                                <GradientStop Color="#FF65A2A0" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- 🦾 КУБИК 2: Киберпанк (Неоновый контур + Сочный Сдержанный Красно-Бордовый фон) 🌌 -->
      



        <Style x:Key="CyberpunkStyle" TargetType="ContentControl">
            <Setter Property="Tag" Value="0"/>
            <Setter Property="Padding" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 👑 ВНЕШНИЙ БОРДЕР: Рамка та же, но фон подкладки осветлен на 10% -->
                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                            BorderThickness="1" BorderBrush="#FFF23E5C" Background="#FF1B222E">
                                <Grid>
                                    <!-- 🥈 СРЕДНИЙ БОРДЕР -->
                                    <Border BorderThickness="1.5" Margin="0" BorderBrush="#40F23E5C" 
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                    Converter={StaticResource RadiusCalc}, ConverterParameter=-0.5}"/>

                                    <!-- 🥉 ВНУТРЕННИЙ БОРДЕР: Основной фон карточки осветлен на 10% (#1C2433 вместо #0C121D) -->
                                    <Border Margin="1.5" BorderThickness="0"
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, 
                                    Converter={StaticResource RadiusCalc}, ConverterParameter=-1.0}"
                                    Background="#FF1C2433">
                                        <!-- Мягкий темно-сизый графит -->

                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="InnerBorderSolidColorStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="8"
                        BorderThickness="0.6"
                        BorderBrush="Black"
                        Background="Transparent">
                            <Border Margin="-0.2"
                           CornerRadius="8"
                           BorderThickness="0.6"
                           BorderBrush="LightBlue"
                           Background="Transparent">
                                <Border Margin="-0.1"
                               BorderThickness="0.3"
                               BorderBrush="DarkRed"
                               CornerRadius="8"
                               Background="{TemplateBinding Background}">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  КУБИК 2:  на ContentControl через честный Tag! 🎛️ -->
        <Style x:Key="TripleBordergreenStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 👑 ВНЕШНИЙ БОРДЕР: Тянет CornerRadius напрямую из кармашка Tag! -->
                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                              BorderThickness="0.65" BorderBrush="Black" Background="White">
                                <Grid>

                                    <!-- 🥈 СРЕДНИЙ БОРДЕР: Берет радиус из Tag и вычитает 0.6 через калькулятор -->
                                    <Border BorderThickness="1.1" Margin="-0.15" BorderBrush="LightBlue" 
                                      CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                  Converter={StaticResource RadiusCalc}, ConverterParameter=-0.6}"/>

                                    <!-- 🥉 ВНУТРЕННИЙ БОРДЕР: Берет радиус из Tag и вычитает 0.65 -->
                                    <Border Margin="0.35" BorderThickness="0.6" BorderBrush="Black"
                                      CornerRadius="{Binding Tag,
                                  RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RadiusCalc}, ConverterParameter=-0.65}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#FF668C66" Offset="0.0"/>
                                                <GradientStop Color="Tan" Offset="0.7"/>
                                                <GradientStop Color="#99104710" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TripleBorderDeepBlueStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 👑 ВНЕШНИЙ БОРДЕР: Тянет CornerRadius напрямую из кармашка Tag! -->
                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                            BorderThickness="0.65" BorderBrush="Black" Background="White">
                                <Grid>

                                    <!-- 🥈 СРЕДНИЙ БОРДЕР: Затемнён под новые глубокие тона для сохранения объёма -->
                                    <Border BorderThickness="1.1" Margin="-0.15" BorderBrush="LightBlue" 
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                    Converter={StaticResource RadiusCalc}, ConverterParameter=-0.6}"/>

                                    <!-- 🥉 ВНУТРЕННИЙ БОРДЕР: Аккуратная сталь, глубокий контрастный тон -->
                                    <Border Margin="0.35" BorderThickness="0.6" BorderBrush="Black"
                                    CornerRadius="{Binding Tag,
                                    RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RadiusCalc}, ConverterParameter=-0.65}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <!-- 🌌 Верх: Углублённый, плотный сине-зелёный (был #FF65A2A0) -->
                                                <GradientStop Color="#FF528785" Offset="0.0"/>

                                                <!-- 🧊 НАЧАЛО РАЗМЫТИЯ: Приглушённый, более тёмный стальной блик (был #FF8AA9A9) -->
                                                <GradientStop Color="#FF718E8E" Offset="0.4"/>

                                                <!-- 🧊 КОНЕЦ РАЗМЫТИЯ: Блик плавно держится до 75% -->
                                                <GradientStop Color="#FF718E8E" Offset="0.75"/>

                                                <!-- 💎 Низ: Возвращение в глубокий базовый тон -->
                                                <GradientStop Color="#FF528785" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#66ABC8AB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0,8,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                      CornerRadius="5"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Background="{TemplateBinding Background}">
                            <Grid Margin="5,0,0,0">
                                <ScrollViewer x:Name="PART_ContentHost"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="DimGray"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>

                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="RoundedListBox" TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                                <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="false">
                                    <ItemsPresenter />
                                </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        

        <Style x:Key="InnerBorderTitleStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border                        
                         BorderThickness="0.3"
                         BorderBrush="Black"
                         CornerRadius="7"
                         Background="#66ABC8AB">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
