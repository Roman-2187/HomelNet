<Application x:Class="HomeSocialNetwork.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfHomeNet" 
             xmlns:vm="clr-namespace:WpfHomeNet.ViewModels"   
             xmlns:cv="clr-namespace:WpfHomeNet.Converters" >
    

    <Application.Resources>
       
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:ViewModelLocator x:Key="VmLocator" />
        <cv:CornerRadiusConverter x:Key="RadiusCalc" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="AntiqueWhite"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     TextElement.FontWeight="{TemplateBinding FontWeight}"
                                     TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Наведение курсора -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#66ABC8AB"/>
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="Black"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="DimGray"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0.6"/>
                            </Trigger>

                            <!-- Нажатие -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFD5D5D5"/>
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#FF000000"/>
                            </Trigger>

                            <!-- Отключённое состояние (ИЗМЕНЕНО) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <!-- Новый цвет -->
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#FF615959"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="BorderedContentStyle" TargetType="ContentControl">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border 
                    BorderThickness="0.15"
                    Margin="1,1,1,0"
                    BorderBrush="Black"
                    Padding="4"
                    CornerRadius="8" 
                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                            <TextBlock
                        Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        FontSize="12"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🧊 КУБИК 1: Синяя сталь на ContentControl через честный Tag! 🎛️ -->
        <Style x:Key="TripleBorderBlueStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 👑 ВНЕШНИЙ БОРДЕР: Тянет CornerRadius напрямую из кармашка Tag! -->
                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                    BorderThickness="0.65" BorderBrush="Black" Background="White">
                                <Grid>

                                    <!-- 🥈 СРЕДНИЙ БОРДЕР: Берет радиус из Tag и вычитает 0.6 через калькулятор -->
                                    <Border BorderThickness="1.1" Margin="-0.15" BorderBrush="LightBlue" 
                                            CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                        Converter={StaticResource RadiusCalc}, ConverterParameter=-0.6}"/>

                                    <!-- 🥉 ВНУТРЕННИЙ БОРДЕР: Берет радиус из Tag и вычитает 0.65 -->
                                    <Border Margin="0.35" BorderThickness="0.6" BorderBrush="Black"
                                            CornerRadius="{Binding Tag,
                                        RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RadiusCalc}, ConverterParameter=-0.65}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <!-- 🌌 Верх: Твой стальной сине-зелёный -->
                                                <GradientStop Color="#FF71B5B3" Offset="0.0"/>

                                                <!-- 🧊 НАЧАЛО РАЗМЫТИЯ: Свет блика начинает плавно входить уже с 40% высоты -->
                                                <GradientStop Color="#FF9ABCBC" Offset="0.4"/>

                                                <!-- 🧊 КОНЕЦ РАЗМЫТИЯ: Свет блика мягко удерживается до 75% высоты -->
                                                <GradientStop Color="#FF9ABCBC" Offset="0.75"/>

                                                <!-- 💎 Низ: Твой стальной сине-зелёный -->
                                                <GradientStop Color="#FF71B5B3" Offset="1.0"/>
                                            </LinearGradientBrush>

                                           
                                        </Border.Background>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🧊 КУБИК 1: Истинный DarkBlue (Мягкое затемнение на 10% от исходного сине-зелёного) 🎛️ -->
        <Style x:Key="TripleBorderDarkBlueStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 👑 ВНЕШНИЙ БОРДЕР: Тянет CornerRadius напрямую из кармашка Tag! -->
                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                            BorderThickness="0.65" BorderBrush="DarkRed" Background="White">
                                <Grid>

                                    <!-- 🥈 СРЕДНИЙ БОРДЕР: Тонкая стальная подложка, чуть темнее для объема -->
                                    <Border BorderThickness="1.1" Margin="-0.15" BorderBrush="#FF4B7E7C" 
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                Converter={StaticResource RadiusCalc}, ConverterParameter=-0.6}"/>

                                    <!-- 🥉 ВНУТРЕННИЙ БОРДЕР: Аккуратная сталь, ровно на 10% плотнее оригинала -->
                                    <Border Margin="0.35" BorderThickness="0.6" BorderBrush="Black"
                                    CornerRadius="{Binding Tag,
                                RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RadiusCalc}, ConverterParameter=-0.65}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <!-- 🌌 Верх: Исходный сине-зелёный, аккуратно притемненный на 10% -->
                                                <GradientStop Color="#FF65A2A0" Offset="0.0"/>

                                                <!-- 🧊 НАЧАЛО РАЗМЫТИЯ: Мягкий, благородный стальной блик -->
                                                <GradientStop Color="#FF8AA9A9" Offset="0.4"/>

                                                <!-- 🧊 КОНЕЦ РАЗМЫТИЯ: Блик плавно и сдержанно держится до 75% -->
                                                <GradientStop Color="#FF8AA9A9" Offset="0.75"/>

                                                <!-- 💎 Низ: Спокойное возвращение в базовый тон -->
                                                <GradientStop Color="#FF65A2A0" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🦾 КУБИК 2: Киберпанк (Неоновый контур + Сочный Сдержанный Красно-Бордовый фон) 🌌 -->
        <Style x:Key="TripleBorderCyberpunkStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 👑 ВНЕШНИЙ БОРДЕР: Рамка на месте, базу сделали мягче -->
                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                            BorderThickness="0.8" BorderBrush="#FF00F5FF" Background="#FF2B1115">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF00F5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                                <Grid>

                                    <!-- 🥈 СРЕДНИЙ БОРДЕР: Уютный переходный бордовый -->
                                    <Border BorderThickness="1.2" Margin="-0.2" BorderBrush="#FF5C1E26" 
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                Converter={StaticResource RadiusCalc}, ConverterParameter=-0.6}"/>

                                    <!-- 🥉 ВНУТРЕННИЙ БОРДЕР: Вывели из глухой темноты в приятный глазу тон -->
                                    <Border Margin="0.4" BorderThickness="0.6" BorderBrush="#FF2E1216"
                                    CornerRadius="{Binding Tag,
                                RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RadiusCalc}, ConverterParameter=-0.65}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <!-- 🌌 Верх: Уверенный бордовый, теперь без черноты -->
                                                <GradientStop Color="#FF4A1A21" Offset="0.0"/>

                                                <!-- ⚡ НАЧАЛО БЛИКА: Мягкий, читаемый неоново-красный отсвет -->
                                                <GradientStop Color="#FF5C232B" Offset="0.4"/>

                                                <!-- ⚡ КОНЕЦ БЛИКА: Держим сочность и объем -->
                                                <GradientStop Color="#FF5C232B" Offset="0.75"/>

                                                <!-- 🔋 Низ: Плавный уход в базовый тон -->
                                                <GradientStop Color="#FF4A1A21" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>




        <Style x:Key="InnerBorderSolidColorStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="8"
                        BorderThickness="0.6"
                        BorderBrush="Black"
                        Background="Transparent">
                            <Border Margin="-0.2"
                           CornerRadius="8"
                           BorderThickness="0.6"
                           BorderBrush="LightBlue"
                           Background="Transparent">
                                <Border Margin="-0.1"
                               BorderThickness="0.3"
                               BorderBrush="DarkRed"
                               CornerRadius="8"
                               Background="{TemplateBinding Background}">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  КУБИК 2:  на ContentControl через честный Tag! 🎛️ -->
        <Style x:Key="TripleBordergreenStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 👑 ВНЕШНИЙ БОРДЕР: Тянет CornerRadius напрямую из кармашка Tag! -->
                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                              BorderThickness="0.65" BorderBrush="Black" Background="White">
                                <Grid>

                                    <!-- 🥈 СРЕДНИЙ БОРДЕР: Берет радиус из Tag и вычитает 0.6 через калькулятор -->
                                    <Border BorderThickness="1.1" Margin="-0.15" BorderBrush="LightBlue" 
                                      CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                  Converter={StaticResource RadiusCalc}, ConverterParameter=-0.6}"/>

                                    <!-- 🥉 ВНУТРЕННИЙ БОРДЕР: Берет радиус из Tag и вычитает 0.65 -->
                                    <Border Margin="0.35" BorderThickness="0.6" BorderBrush="Black"
                                      CornerRadius="{Binding Tag,
                                  RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RadiusCalc}, ConverterParameter=-0.65}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#FF668C66" Offset="0.0"/>
                                                <GradientStop Color="Tan" Offset="0.7"/>
                                                <GradientStop Color="#99104710" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TripleBorderDeepBlueStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- 👑 ВНЕШНИЙ БОРДЕР: Тянет CornerRadius напрямую из кармашка Tag! -->
                            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                            BorderThickness="0.65" BorderBrush="DarkRed" Background="White">
                                <Grid>

                                    <!-- 🥈 СРЕДНИЙ БОРДЕР: Затемнён под новые глубокие тона для сохранения объёма -->
                                    <Border BorderThickness="1.1" Margin="-0.15" BorderBrush="#FF3A6260" 
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                    Converter={StaticResource RadiusCalc}, ConverterParameter=-0.6}"/>

                                    <!-- 🥉 ВНУТРЕННИЙ БОРДЕР: Аккуратная сталь, глубокий контрастный тон -->
                                    <Border Margin="0.35" BorderThickness="0.6" BorderBrush="Black"
                                    CornerRadius="{Binding Tag,
                                    RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RadiusCalc}, ConverterParameter=-0.65}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <!-- 🌌 Верх: Углублённый, плотный сине-зелёный (был #FF65A2A0) -->
                                                <GradientStop Color="#FF528785" Offset="0.0"/>

                                                <!-- 🧊 НАЧАЛО РАЗМЫТИЯ: Приглушённый, более тёмный стальной блик (был #FF8AA9A9) -->
                                                <GradientStop Color="#FF718E8E" Offset="0.4"/>

                                                <!-- 🧊 КОНЕЦ РАЗМЫТИЯ: Блик плавно держится до 75% -->
                                                <GradientStop Color="#FF718E8E" Offset="0.75"/>

                                                <!-- 💎 Низ: Возвращение в глубокий базовый тон -->
                                                <GradientStop Color="#FF528785" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#66ABC8AB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0,8,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                      CornerRadius="5"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Background="{TemplateBinding Background}">
                            <Grid Margin="5,0,0,0">
                                <ScrollViewer x:Name="PART_ContentHost"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="DimGray"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>

                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="RoundedListBox" TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                                <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="false">
                                    <ItemsPresenter />
                                </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        

        <Style x:Key="InnerBorderTitleStyle" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border                        
                         BorderThickness="0.3"
                         BorderBrush="Black"
                         CornerRadius="7"
                         Background="#66ABC8AB">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
