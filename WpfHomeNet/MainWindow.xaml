<Window x:Class="WpfHomeNet.MainWindow"  WindowStartupLocation="Manual"       
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:WpfHomeNet.Controls"     
    xmlns:local="clr-namespace:WpfHomeNet.UiHelpers"   
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WpfHomeNet.ViewModels"  
    xmlns:relayComand="clr-namespace:WpfHomeNet"    
    xmlns:converter="clr-namespace:WpfHomeNet.Converters"
    mc:Ignorable="d"        
    WindowStyle="None"
    ResizeMode="CanResize"                             
    AllowsTransparency="True"
    FontFamily="Calibri"
    FontSize="14"                             
    Background="Transparent"
    Width="800" Height="600"
    MinWidth="800" MinHeight="600"> 
   
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9.4"/>
            <Setter Property="BorderThickness" Value="0.6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converter:InverseBooleanToVisibilityConverter x:Key="InverseBooleanVisibleConverter"/>
    </Window.Resources>

    <ContentControl 
        Style="{StaticResource TripleBorderStyle}"                    
        Width="800"                         
        Height="600"
        MinWidth="800"                     
        MinHeight="600"                    
        HorizontalAlignment="Center"                    
        VerticalAlignment="Center"
        MouseDown="WindowDrag_MouseDown">

        <Grid x:Name="MainGrid" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <!-- Шапка приложения -->
            <Border Grid.Row="0" Grid.Column="0">
                <Label HorizontalAlignment="Center" 
                       FontWeight="Bold"
                       Content="HomeNet"
                       FontSize="20"
                       Foreground="Black"/>
            </Border>

            <!-- Кнопка закрытия ("Крестик" всегда на самом верхнем слое)" -->
            <Button Grid.Row="0" Grid.Column="5"              
                     Click="CloseButton_Click"
                    Panel.ZIndex="100"
                    Content="×" Width="Auto"/>

            <!-- АДМИНКА: Маска на всё окно -->        
            <controls:AdminMenu
                Grid.Row="1" Grid.RowSpan="4"
                Grid.Column="0" Grid.ColumnSpan="6"
                Panel.ZIndex="98" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Visibility="{Binding DataContext.AdminMenuVisibility, 
                RelativeSource={RelativeSource AncestorType=Window}}"
                DataContext="{Binding AdminMenuVm, 
                Source={StaticResource VmLocator}}" />


            <!-- ВЕРХНЕЕ МЕНЮ: Схлопывается целиком, когда сессия завершена -->
            <StackPanel
                Visibility="{Binding MainVm.IsComplete,
                Source={StaticResource VmLocator},
                Converter={StaticResource InverseBooleanVisibleConverter}}"
                IsEnabled="{Binding IsButtonsPanelEnabled}"
                HorizontalAlignment="Right"
                Grid.Row="0" Grid.Column="2"                                                  
                Orientation="Horizontal"                        
                Grid.ColumnSpan="3"
                Margin="0,0,45,0">             
                        

                <Button
                    MinWidth="100"   
                    Command="{Binding ToggleAdminMenuCommand}"                      
                    Content="🛠️ Админка" />

                <!-- Кнопки завернуты в изолированный пакет! 🦾 -->
                <StackPanel
                    Orientation="Horizontal"
                    Visibility="{Binding DataContext.AdminMenuVisibility,
                    RelativeSource={RelativeSource AncestorType=Window}, 
                    Converter={StaticResource InverseBooleanVisibleConverter}}">
                    <Button 
                        MinWidth="120"   
                        Command="{Binding ToggleFormVisibilityCommand}"
                        CommandParameter="{Binding RegistrationVm,
                        Source={StaticResource VmLocator}}" 
                        Content="Регистрация" />

                    <Button
                        MinWidth="120"                       
                        Command="{Binding ToggleFormVisibilityCommand}"
                        CommandParameter="{Binding LoginVm,
                        Source={StaticResource VmLocator}}"                    
                        Content="Вход в профиль" />
                </StackPanel>
            </StackPanel>

                
             <!-- КНОПКА ВЫХОДА ИЗ АККАУНТА  -->
             <Button 
                Grid.Row="0" Grid.Column="3" 
                Grid.ColumnSpan="2" 
                MinWidth="140"
                HorizontalAlignment="Right"
                Margin="0,0,45,0"
                Command="{Binding LogoutCommand}"
                Content="Выйти из аккаунта"                     
                Visibility="{Binding MainVm.IsComplete,
                Source={StaticResource VmLocator},
                Converter={StaticResource BooleanToVisibilityConverter}}" />     

            <!-- ФОРМА РЕГИСТРАЦИИ (ZIndex 99 — поверх админки) -->
            <controls:RegistrationViewControl 
                Grid.Row="1" Grid.Column="1"
                Grid.ColumnSpan="4" Grid.RowSpan="4" 
                Panel.ZIndex="99" 
                DataContext="{Binding RegistrationVm,
                Source={StaticResource VmLocator}}" 
                Visibility="{Binding ControlVisibility}"
                d:Visibility="Hidden" />

            <!-- ФОРМА ЛОГИНА (ZIndex 99 — поверх админки) -->
            <controls:LoginViewControl
                Grid.Row="1" Grid.Column="1"
                Grid.ColumnSpan="4" Grid.RowSpan="4"
                Panel.ZIndex="99"
                DataContext="{Binding LoginVm,
                Source={StaticResource VmLocator}}" 
                Visibility="{Binding ControlVisibility}"
                d:Visibility="Hidden" />

            <!-- КОНТЕЙНЕР СТАТУС-БАР -->
            <controls:StatusBarControl
                DataContext="{Binding StatusBarVm,
                Source={StaticResource VmLocator}}"
                Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="6" 
                VerticalAlignment="Bottom"/>
        </Grid>
    </ContentControl>
</Window>




