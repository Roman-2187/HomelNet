<Window x:Class="WpfHomeNet.MainWindow"       
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:WpfHomeNet.Controls"     
    xmlns:local="clr-namespace:WpfHomeNet.UiHelpers"   
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WpfHomeNet.ViewModels"  
    xmlns:relayComand="clr-namespace:WpfHomeNet"    
    xmlns:converter="clr-namespace:WpfHomeNet.Converters"
    mc:Ignorable="d"        
    WindowStyle="None"
    ResizeMode="CanResize"                             
    AllowsTransparency="True"
    FontFamily="Calibri"
    FontSize="14"                             
    Background="Transparent"  WindowStartupLocation="CenterScreen"
    
    Width="950" Height="650"> 
   
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9.4"/>
            <Setter Property="BorderThickness" Value="0.6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converter:InverseBooleanToVisibilityConverter x:Key="InverseBooleanVisibleConverter"/>
    </Window.Resources>


    <ContentControl Style="{StaticResource CyberpunkStyle}" 
                
                Width="950" Height="650" 
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonDown="WindowDrag_MouseDown">
        <ContentControl.Tag>
            
            <CornerRadius>10</CornerRadius>
        </ContentControl.Tag>

        
                         
        

        <Grid x:Name="MainGrid" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <!-- Шапка приложения -->
            <Border Grid.Row="0" Grid.Column="0">
                <Label HorizontalAlignment="Center" 
                       FontWeight="Bold"
                       Content="HomeNet"
                       FontSize="20"
                       Foreground="#FFB300"/>
            </Border>

            <!-- Кнопка закрытия -->
            <Button Grid.Row="0" Grid.Column="5"              
                    Click="CloseButton_Click"
                    Panel.ZIndex="100"
                    Content="×" Width="Auto"/>

            <!-- АДМИНКА: Теперь привязка жестко зафиксирована на окне -->
            <controls:AdminMenu   d:Visibility="Collapsed"
                Grid.Row="1" Grid.RowSpan="4"
                Grid.Column="0" Grid.ColumnSpan="6"
                Panel.ZIndex="98" 
               
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Visibility="{Binding DataContext.AdminMenuVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                DataContext="{Binding AdminMenuVm, Source={StaticResource VmLocator}}" />

            <!-- ================================================================= -->
            <!-- 🛸 ЦЕНТРАЛЬНЫЙ СТАК ШАПКИ: КНОПКА АДМИНКИ И ГОСТЕВОЙ ИНТЕРФЕЙС -->
            <!-- ================================================================= -->
            <StackPanel
                HorizontalAlignment="Right"
                Grid.Row="0" Grid.Column="2"                                                  
                Orientation="Horizontal"                        
                Grid.ColumnSpan="3"
                Margin="0,0,45,0">
                <!-- 🔥 ВОЗВРАЩАЕМ УПРАВЛЕНИЕ ВИДИМОСТЬЮ ДЛЯ ВСЕГО СТАКА КНОПОК! -->
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <!-- Как только вошли в личный кабинет — уничтожаем гостевые кнопки с экрана! 🧼 -->
                            <DataTrigger Binding="{Binding MainVm.MainInterfaceVisibility, Source={StaticResource VmLocator}}" Value="Visible">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- 🛠️ КНОПКА АДМИНКИ: Теперь она ТОЖЕ тухнет, если на радаре открыта форма ввода! 🔐 -->
                <Button MinWidth="100"   
                        Command="{Binding ToggleAdminMenuCommand}"                      
                        Content="🛠️ Админка"
                        IsEnabled="{Binding MainVm.IsButtonsPanelEnabled, Source={StaticResource VmLocator}}"
                       />

                <!-- 📦 ВНУТРЕННИЙ Контейнер больше НЕ имеет никаких стилей и блокировок! -->
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">

                    <StackPanel.Resources>
                        <!-- 🌟 ИСПРАВЛЕНО: Наследуемся от стандартного стиля кнопок через BasedOn -->
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <!-- ТРИГГЕР 1: Если радар окон занят вводом данных -->
                                <DataTrigger Binding="{Binding MainVm.IsButtonsPanelEnabled, Source={StaticResource VmLocator}}" Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>

                                <!-- ТРИГГЕР 2: Если админка открыта на экране — гостевые кнопки тухнут! -->
                                <DataTrigger Binding="{Binding MainVm.AdminMenuVisibility, Source={StaticResource VmLocator}}" Value="Visible">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>

                    <!-- Твои родные красивые кнопки заберут этот стиль, сохранят свой дизайн и будут баниться точечно! -->
                    <Button MinWidth="120"   
                Command="{Binding ToggleFormVisibilityCommand}"
                CommandParameter="{Binding RegistrationVm, Source={StaticResource VmLocator}}" 
                Content="Регистрация" />

                    <Button MinWidth="120"                       
                Command="{Binding ToggleFormVisibilityCommand}"
                CommandParameter="{Binding LoginVm, Source={StaticResource VmLocator}}"                    
                Content="Вход в профиль" />
                </StackPanel>

            </StackPanel>



            <!-- 🔥 КНОПКА ВЫХОДА (Появляется вместо гостевой панели) -->
            <Button 
                Grid.Row="0" Grid.Column="3" 
                Grid.ColumnSpan="2" 
                MinWidth="140"
                HorizontalAlignment="Right"
                Margin="0,0,45,0"
                Command="{Binding LogoutCommand}"
                Content="Выйти из аккаунта"                     
                Visibility="{Binding MainInterfaceVisibility}" />

            <!-- ФОРМА РЕГИСТРАЦИИ -->
            <controls:RegistrationViewControl 
                Grid.Row="1" Grid.Column="1" Margin="65,6,6,6"
                Grid.ColumnSpan="5" Grid.RowSpan="4" 
                Panel.ZIndex="99" 
                DataContext="{Binding RegistrationVm, Source={StaticResource VmLocator}}" 
                Visibility="{Binding ControlVisibility}"
                 d:Visibility="Hidden"/>

            <!-- ФОРМА ЛОГИНА -->
            <controls:LoginViewControl
                Grid.Row="1" Grid.Column="1"  Margin="65,6,6,6"
                Grid.ColumnSpan="5" Grid.RowSpan="4"
                Panel.ZIndex="99"
                DataContext="{Binding LoginVm, Source={StaticResource VmLocator}}" 
                Visibility="{Binding ControlVisibility}"
                 />

            <!-- 👤 МАСКА АВТОРИЗОВАННОГО ПОЛЬЗОВАТЕЛЯ -->
            <!-- 🔥 ИСПРАВЛЕНО: Ищем видимость строго в контексте главного окна! -->
            <controls:UserDashboardControl  d:Visibility="Collapsed"
                Grid.Row="1" Grid.RowSpan="4"
                Grid.Column="0" Grid.ColumnSpan="6"
                Panel.ZIndex="50"
                
                
                Visibility="{Binding DataContext.MainInterfaceVisibility,
                RelativeSource={RelativeSource AncestorType=Window}}"
                
                DataContext="{Binding UserDashboardVm, Source={StaticResource VmLocator}}" />



                <!-- КОНТЕЙНЕР СТАТУС-БАР -->
            <controls:StatusBarControl
                DataContext="{Binding StatusBarVm, Source={StaticResource VmLocator}}"
                Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="6" 
                VerticalAlignment="Bottom"/>
        </Grid>

    </ContentControl>
</Window>




