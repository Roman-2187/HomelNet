<Window x:Class="WpfHomeNet.LogWindow" 
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Логи" Height="630
        " Width="700"
         BorderThickness="3"
        Background="Transparent"
     
         WindowStyle="None"
        AllowsTransparency="True" 
        >

    <ContentControl Style="{StaticResource TripleBorderBlueStyle}" >
        <ContentControl.Tag>
            <CornerRadius>12</CornerRadius>
            <!-- Внутренняя матрешка тоже хочет знать радиус! -->
        </ContentControl.Tag>
        <Grid>
        <!-- Разделение на две области: верхняя для лога, нижняя для дополнительных элементов -->
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- Панель инструментов -->
            <RowDefinition Height="*"/>
            <!-- Область лога -->
        </Grid.RowDefinitions>

        <!-- Панель инструментов (можно добавить кнопки очистки, фильтрации и т.д.) -->
        <StackPanel Grid.Row="0" 
               Background="Transparent" 
               Orientation="Horizontal" 
               >
            <Label Content="Окно логов" FontSize="16"
                FontWeight="Bold"
                
                HorizontalAlignment="Center"
                BorderThickness="0"
                VerticalAlignment="Center" />
               
            
            <!-- Другие кнопки управления -->
               
        </StackPanel >

        <!-- Область лога -->



            <RichTextBox x:Name="LogTextBox" Margin="10,0,10,10" Grid.Row="1"                 
             VerticalScrollBarVisibility="Hidden"
             IsReadOnly="True" FontSize="14" FontWeight="Bold"
             Foreground="White" SelectionBrush="#FF297AB8">
                <RichTextBox.Style>
                    <Style TargetType="RichTextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <!-- 🔥 ВЫРЕЗАЕМ СТАНДАРТНЫЙ ПРЯМОУГОЛЬНИК И СТАВИМ СВОЙ С КРУГЛЫМИ УГЛАМИ -->
                                <ControlTemplate TargetType="RichTextBox">
                                    <Border x:Name="bg" 
                                CornerRadius="6" 
                                Background="#FF464545" 
                                BorderBrush="#FFAAADB5" 
                                BorderThickness="1">
                                        <!-- Этот элемент WPF обязан быть внутри шаблона, чтобы текст вообще отображался -->
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="5"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </RichTextBox.Style>
            </RichTextBox>






        </Grid>
        </ContentControl>

</Window>
